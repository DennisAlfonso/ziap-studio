<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ZiapStudio.Views.FusionStoryDocumentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:story="using:ZiapStudio.Core.Fusion.Story"
    xmlns:viewModels="using:ZiapStudio.ViewModels">

    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FocusSearch_Invoked" />
        <KeyboardAccelerator Key="Escape" Invoked="ClearSearch_Invoked" />
    </UserControl.KeyboardAccelerators>

    <Grid Padding="32,26" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock FontSize="30" FontWeight="SemiBold" Text="Story &amp; Events" />
                    <Border Padding="8,3" VerticalAlignment="Center" Background="{ThemeResource AccentFillColorSecondaryBrush}" CornerRadius="5">
                        <TextBlock FontSize="10" FontWeight="SemiBold" Text="MASTER AUTHORING" />
                    </Border>
                </StackPanel>
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Timeline semantica degli eventi RPG Maker MZ con localizzazione Fusion risolta." />
            </StackPanel>
            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding WorkspaceStatusText}" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="330" MinWidth="280" MaxWidth="440" /><ColumnDefinition Width="*" /><ColumnDefinition Width="285" /></Grid.ColumnDefinitions>
            <Border Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                <Grid RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="Sorgenti narrative" />
                    <Grid Grid.Row="1" ColumnSpacing="6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="StorySearchBox" PlaceholderText="Cerca storia…" Text="{Binding Navigator.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="{Binding Navigator.FilterLabel}">
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <ScrollViewer MaxHeight="460" MinWidth="220"><StackPanel Spacing="8">
                                        <TextBlock FontWeight="SemiBold" Text="Source" />
                                        <StackPanel Orientation="Horizontal" Spacing="5"><Button Click="FilterSourceAll_Click" Content="All" /><Button Click="FilterSourceMaps_Click" Content="Maps" /><Button Click="FilterSourceCommon_Click" Content="Common Events" /></StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="Content type" />
                                        <CheckBox Content="Dialogue" IsChecked="{Binding Navigator.Filters.Dialogue, Mode=TwoWay}" /><CheckBox Content="Choices" IsChecked="{Binding Navigator.Filters.Choices, Mode=TwoWay}" />
                                        <CheckBox Content="Movement" IsChecked="{Binding Navigator.Filters.Movement, Mode=TwoWay}" /><CheckBox Content="Audio" IsChecked="{Binding Navigator.Filters.Audio, Mode=TwoWay}" />
                                        <CheckBox Content="Logic" IsChecked="{Binding Navigator.Filters.Logic, Mode=TwoWay}" /><CheckBox Content="Transfer" IsChecked="{Binding Navigator.Filters.Transfer, Mode=TwoWay}" />
                                        <CheckBox Content="Plugin" IsChecked="{Binding Navigator.Filters.Plugin, Mode=TwoWay}" /><CheckBox Content="Script" IsChecked="{Binding Navigator.Filters.Script, Mode=TwoWay}" />
                                        <CheckBox Content="Comment" IsChecked="{Binding Navigator.Filters.Comment, Mode=TwoWay}" /><CheckBox Content="Raw" IsChecked="{Binding Navigator.Filters.Raw, Mode=TwoWay}" />
                                        <TextBlock FontWeight="SemiBold" Text="Localization" />
                                        <CheckBox Content="Localized" IsChecked="{Binding Navigator.Filters.Localized, Mode=TwoWay}" /><CheckBox Content="Raw / literal" IsChecked="{Binding Navigator.Filters.Literal, Mode=TwoWay}" />
                                        <CheckBox Content="Editable master" IsChecked="{Binding Navigator.Filters.EditableMaster, Mode=TwoWay}" />
                                        <TextBlock FontWeight="SemiBold" Text="Page" />
                                        <CheckBox Content="With conditions" IsChecked="{Binding Navigator.Filters.WithConditions, Mode=TwoWay}" /><CheckBox Content="Without conditions" IsChecked="{Binding Navigator.Filters.WithoutConditions, Mode=TwoWay}" />
                                        <TextBlock FontWeight="SemiBold" Text="Advanced" /><CheckBox Content="Search technical/raw data" IsChecked="{Binding Navigator.Filters.Technical, Mode=TwoWay}" />
                                        <Button Click="ClearFilters_Click" Content="Clear filters" />
                                    </StackPanel></ScrollViewer>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                        <Button Click="ShowMaps_Click" Content="MAPS" /><Button Click="ShowCommonEvents_Click" Content="COMMON EVENTS" />
                    </StackPanel>
                    <Grid Grid.Row="3">
                        <Grid Visibility="{Binding Navigator.IsMapsMode, Converter={StaticResource BooleanToVisibilityConverter}}" RowSpacing="8">
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TreeView ItemInvoked="MapTree_ItemInvoked" ItemsSource="{Binding Navigator.MapRoots}" SelectionMode="None">
                                <TreeView.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:StoryMapTreeItemViewModel">
                                        <TreeViewItem AutomationProperties.Name="{x:Bind DisplayName}" IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}" ItemsSource="{x:Bind Children}">
                                            <TreeViewItem.Content>
                                                <Grid ColumnSpacing="7"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock FontFamily="Consolas" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind IdText}" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind CountText}" />
                                                </Grid>
                                            </TreeViewItem.Content>
                                        </TreeViewItem>
                                    </DataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                            <StackPanel Grid.Row="1" Spacing="2"><TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Navigator.SelectedMap.DisplayName}" /><TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="EVENTS" /></StackPanel>
                            <ListView Grid.Row="2" HorizontalContentAlignment="Stretch" ItemsSource="{Binding Navigator.Events}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:StoryEventNavigatorItemViewModel">
                                            <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                            <Expander.Header><Button AutomationProperties.Name="{x:Bind Name}" Click="Event_Click" Tag="{Binding}" Padding="2"><StackPanel Spacing="1"><StackPanel Orientation="Horizontal" Spacing="7"><TextBlock FontFamily="Consolas" FontSize="10" Text="{x:Bind IdText}" /><TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" /></StackPanel><TextBlock FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind CoordinatesAndPages}" /></StackPanel></Button></Expander.Header>
                                            <ListView HorizontalContentAlignment="Stretch" ItemsSource="{x:Bind Pages}" SelectionMode="None">
                                                <ListView.ItemTemplate><DataTemplate x:DataType="viewModels:StoryPageNavigatorItemViewModel"><Button AutomationProperties.Name="{x:Bind Title}" Click="Page_Click" Tag="{Binding}" HorizontalContentAlignment="Stretch" Padding="5,4"><StackPanel Spacing="1"><TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" /><TextBlock FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Detail}" TextWrapping="Wrap" /></StackPanel></Button></DataTemplate></ListView.ItemTemplate>
                                            </ListView>
                                        </Expander>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                        <ListView HorizontalContentAlignment="Stretch" IsItemClickEnabled="True" ItemClick="CommonEvent_ItemClick" ItemsSource="{Binding Navigator.CommonEvents}" SelectionMode="None" Visibility="{Binding Navigator.IsCommonEventsMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ListView.ItemTemplate><DataTemplate x:DataType="viewModels:StoryCommonEventNavigatorItemViewModel"><Grid Padding="4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock FontFamily="Consolas" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind IdText}" /><StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="2"><TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" /><TextBlock FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Detail}" TextWrapping="Wrap" /></StackPanel></Grid></DataTemplate></ListView.ItemTemplate>
                        </ListView>
                        <ListView HorizontalContentAlignment="Stretch" IsItemClickEnabled="True" ItemClick="SearchResult_ItemClick" ItemsSource="{Binding Navigator.SearchResults}" SelectionMode="None" Visibility="{Binding Navigator.IsSearchMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ListView.ItemTemplate><DataTemplate x:DataType="story:StorySearchResult"><StackPanel Padding="4" Spacing="2"><TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="{x:Bind Kind}" /><TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" /><TextBlock FontSize="11" Text="{x:Bind Snippet}" TextTrimming="CharacterEllipsis" /><TextBlock FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Breadcrumb}" TextTrimming="CharacterEllipsis" /></StackPanel></DataTemplate></ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                    <TextBlock Grid.Row="4" Margin="0,4,0,0" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Navigator.SearchStatusText}" TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Spacing="2"><TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding SelectedSourceTitle}" /><TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding SelectedSourceDetail}" TextWrapping="Wrap" /></StackPanel>
                <ListView x:Name="TimelineList" Grid.Row="1" HorizontalContentAlignment="Stretch" ItemsSource="{Binding Blocks}" SelectedItem="{Binding SelectedBlock, Mode=TwoWay}" SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="story:StoryBlock">
                            <Border Margin="0,0,0,8" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                                <StackPanel Spacing="5">
                                    <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="{x:Bind KindText}" />
                                        <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" FontFamily="Consolas" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind CommandRangeText}" />
                                    </Grid>
                                    <TextBlock Text="{x:Bind DisplayText}" TextWrapping="Wrap" />
                                    <TextBlock FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind LocalizationOriginText}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Border Grid.Column="2" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="10">
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="Inspector" />
                    <TextBlock FontWeight="SemiBold" Text="{Binding SelectedBlock.KindText}" />
                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding SelectedBlock.CommandRangeText}" />
                    <TextBlock Text="{Binding SelectedBlock.DisplayText}" TextWrapping="Wrap" />
                    <TextBlock FontSize="10" FontWeight="SemiBold" Text="CONTENT" />
                    <TextBlock FontSize="10" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="{Binding AuthoringStateText}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding LocalizationFields}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:StoryLocalizationFieldViewModel">
                                <StackPanel Spacing="3">
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Text="{x:Bind Label}" />
                                    <TextBox AcceptsReturn="True" IsReadOnly="{x:Bind IsReadOnly}" MinHeight="34" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                                    <TextBlock FontFamily="Consolas" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Path}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Click="EditMasterText_Click" Content="Edit master text" IsEnabled="{Binding CanBeginEditing}" />
                        <Button Click="SaveToStaging_Click" Content="Save to ZIAP Staging" IsEnabled="{Binding CanSaveToStaging}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Click="UndoLocalization_Click" Content="Undo" IsEnabled="{Binding CanUndoLocalization}" />
                        <Button Click="RedoLocalization_Click" Content="Redo" IsEnabled="{Binding CanRedoLocalization}" />
                        <Button Click="DiscardLocalization_Click" Content="Discard" IsEnabled="{Binding CanDiscardLocalization}" />
                        <Button Click="RetryMirror_Click" Content="Retry sync" IsEnabled="{Binding CanRetryMirror}" />
                    </StackPanel>
                    <TextBlock FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding AuthoringMessage}" TextWrapping="Wrap" />
                    <TextBlock FontSize="10" FontWeight="SemiBold" Text="COMPOSE STORY" />
                    <StackPanel Spacing="4" Visibility="{Binding Composer.HasRecovery, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Composer.RecoveryMessage}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Click="CompleteRecovery_Click" Content="Complete local insertion" />
                            <Button Click="DismissRecovery_Click" Content="Dismiss recovery" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Click="AddDialogueAfter_Click" Content="+ Dialogue after" IsEnabled="{Binding Composer.CanStart}" />
                        <Button Click="AddNarrationAfter_Click" Content="+ Narration after" IsEnabled="{Binding Composer.CanStart}" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="11" FontWeight="SemiBold" Text="Speaker" Visibility="{Binding Composer.IsDialogue, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBox Text="{Binding Composer.Speaker, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding Composer.IsDialogue, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock FontSize="11" FontWeight="SemiBold" Text="Text" />
                        <TextBox AcceptsReturn="True" MinHeight="60" Text="{Binding Composer.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                        <TextBlock FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Composer.Message}" TextWrapping="Wrap" />
                        <TextBox AcceptsReturn="True" FontFamily="Consolas" FontSize="10" IsReadOnly="True" MinHeight="90" Text="{Binding Composer.PreviewText}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Click="PreviewComposition_Click" Content="Preview" IsEnabled="{Binding Composer.CanPreview}" />
                            <Button Click="CommitComposition_Click" Content="Add to story" IsEnabled="{Binding Composer.CanCommit}" />
                        </StackPanel>
                        <Button Click="UnlinkStoryBlock_Click" Content="Remove from event" IsEnabled="{Binding Composer.CanUnlink}" />
                        <TextBlock FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Remove from event preserves Localization; it never deletes or renumbers MDV." TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock FontSize="10" FontWeight="SemiBold" Text="LOCALIZATION ORIGIN" />
                    <TextBlock FontFamily="Consolas" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding SelectedBlock.LocalizationOriginText}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding SelectedBlockDetails}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock FontSize="11" Text="{x:Bind}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <Expander Header="Raw text" IsExpanded="False"><TextBox AcceptsReturn="True" FontFamily="Consolas" FontSize="10" IsReadOnly="True" Text="{Binding SelectedBlock.RawText}" TextWrapping="Wrap" /></Expander>
                    <Expander Header="Raw parameters" IsExpanded="False"><TextBox AcceptsReturn="True" FontFamily="Consolas" FontSize="10" IsReadOnly="True" Text="{Binding SelectedBlock.RawParameters}" TextWrapping="Wrap" /></Expander>
                    <Expander Header="Source commands" IsExpanded="False"><ItemsControl ItemsSource="{Binding SelectedBlockRawCommands}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="story:StoryRawCommand"><TextBlock FontFamily="Consolas" FontSize="10" Text="{x:Bind Parameters}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
                </StackPanel></ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
