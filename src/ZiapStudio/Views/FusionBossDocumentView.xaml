<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ZiapStudio.Views.FusionBossDocumentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bosses="using:ZiapStudio.Core.Fusion.Bosses"
    xmlns:viewModels="using:ZiapStudio.ViewModels"
    xmlns:views="using:ZiapStudio.Views">

    <Grid Padding="32,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock FontSize="30" FontWeight="SemiBold" Text="Fusion Boss Battle" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Ispeziona encounter, timeline e geometria delle arene del boss engine." />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                <Button
                    x:Name="EditModeButton"
                    Click="ToggleEditMode_Click"
                    Content="Modifica"
                    IsEnabled="{Binding CanAuthor}"
                    ToolTipService.ToolTip="Apre l'inspector di authoring senza nascondere la preview" />
                <Button
                    x:Name="FocusModeButton"
                    Click="ToggleFocusMode_Click"
                    Content="Focus"
                    ToolTipService.ToolTip="Nasconde il selettore degli encounter e amplia l'area di lavoro" />
                <Border
                    Padding="10,5"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="6"
                    ToolTipService.ToolTip="{Binding WorkspaceCountSummaryText}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="{Binding StatusText}" />
                        <TextBlock Text="{Binding WarningText}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid x:Name="WorkspaceGrid" Grid.Row="1" Margin="0,18,0,0" ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="EncounterPanelColumn" Width="260" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="EditorPanelColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="EncounterPanel"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <Grid Padding="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Encounter" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Seleziona una boss battle da ispezionare." />
                    </StackPanel>
                    <ListView
                        Grid.Row="1"
                        Margin="0,12,0,0"
                        HorizontalContentAlignment="Stretch"
                        ItemsSource="{Binding Encounters}"
                        SelectedItem="{Binding SelectedEncounter, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:FusionBossEncounterViewModel">
                                <StackPanel Padding="5,6" Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Id}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            FontSize="10"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Text="{x:Bind BossText}" />
                                        <TextBlock
                                            FontSize="10"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Text="{x:Bind PhaseCountText}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Expander Grid.Row="2" Header="Workspace" IsExpanded="False">
                        <StackPanel Margin="0,8,0,0" Spacing="7">
                            <ItemsControl ItemsSource="{Binding Databases}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:FusionBossDatabaseViewModel">
                                        <Grid Margin="0,2" ColumnSpacing="7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind StatusGlyph}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind DisplayName}" />
                                            <TextBlock
                                                Grid.Column="2"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind RecordCountText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{Binding DiagnosticsTitle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander>
                </Grid>
            </Border>

            <TabView
                x:Name="FusionModeTabs"
                Grid.Column="1"
                CanReorderTabs="False"
                HorizontalContentAlignment="Stretch"
                IsAddTabButtonVisible="False"
                TabWidthMode="SizeToContent"
                VerticalContentAlignment="Stretch">
                <TabViewItem
                    Header="Panoramica"
                    HorizontalContentAlignment="Stretch"
                    IsClosable="False"
                    VerticalContentAlignment="Stretch">
                    <Grid Margin="0,10,0,0" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Struttura dell'encounter" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Seleziona una fase per isolarne entrate, uscite e condizioni." />
                            </StackPanel>
                            <ComboBox
                                Grid.Column="1"
                                Header="Fase"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{Binding Phases}"
                                SelectedItem="{Binding SelectedPhase, Mode=TwoWay}" />
                        </Grid>
                        <Border
                            Grid.Row="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <views:FusionEncounterGraphView DataContext="{Binding}" />
                        </Border>
                        <Border
                            Grid.Row="2"
                            Padding="14,11"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <ContentControl Content="{Binding SelectedPhase}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="viewModels:FusionBossPhaseViewModel">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="3">
                                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="{x:Bind DisplayName}" />
                                                <TextBlock
                                                    FontFamily="Consolas"
                                                    FontSize="10"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    Text="{x:Bind TechnicalIdText}" />
                                                <StackPanel Orientation="Horizontal" Spacing="9">
                                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind SequenceCountText}" />
                                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind TransitionCountText}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="9">
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind MechanicCountText}" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                        Text="{x:Bind HookStepCountText}"
                                                        ToolTipService.ToolTip="{x:Bind HookSummaryText}" />
                                                </StackPanel>
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    Text="{x:Bind MechanicsText}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="8">
                                                <StackPanel Spacing="4">
                                                    <TextBlock
                                                        FontSize="10"
                                                        FontWeight="SemiBold"
                                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                        Text="{x:Bind DocumentationStatusText}" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind ContextText}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBlock
                                                    FontFamily="Consolas"
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind TransitionDetailText}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                        </Border>
                    </Grid>
                </TabViewItem>
                <TabViewItem
                    Header="Esecuzione"
                    HorizontalContentAlignment="Stretch"
                    IsClosable="False"
                    VerticalContentAlignment="Stretch">
                    <Grid Margin="0,10,0,0" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Esecuzione della fase" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding ExecutionGraphSummaryText}" />
                                <TextBlock
                                    FontSize="10"
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                    Text="{Binding ExecutionGraphWarningText}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox
                                Grid.Column="1"
                                Header="Fase"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{Binding Phases}"
                                SelectedItem="{Binding SelectedPhase, Mode=TwoWay}" />
                        </Grid>

                        <Border
                            Grid.Row="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <views:FusionExecutionGraphView DataContext="{Binding}" />
                        </Border>

                        <Border
                            Grid.Row="2"
                            Padding="14,11"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentControl Content="{Binding SelectedExecutionNode}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate x:DataType="bosses:FusionBossExecutionNode">
                                            <Grid ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="240" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="3">
                                                    <TextBlock
                                                        FontSize="16"
                                                        FontWeight="SemiBold"
                                                        Text="{x:Bind DisplayName}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock
                                                            FontSize="10"
                                                            FontWeight="SemiBold"
                                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                            Text="{x:Bind BadgeText}" />
                                                        <TextBlock
                                                            FontFamily="Consolas"
                                                            FontSize="10"
                                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                            Text="{x:Bind TechnicalId}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        FontSize="10"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind DurationSummary}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="5">
                                                    <TextBlock
                                                        FontSize="11"
                                                        Text="{x:Bind StartReason}"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind CallerSummary}"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock
                                                        FontSize="10"
                                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                        Text="{x:Bind OutcomeSummary}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>
                                <Button
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Click="OpenSelectedExecutionTimeline_Click"
                                    Content="Apri timeline"
                                    IsEnabled="{Binding CanOpenSelectedExecutionTimeline}" />
                            </Grid>
                        </Border>
                    </Grid>
                </TabViewItem>
                <TabViewItem
                    Header="Timeline"
                    HorizontalContentAlignment="Stretch"
                    IsClosable="False"
                    VerticalContentAlignment="Stretch">
                    <Grid Margin="0,10,0,0" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="210" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.ColumnSpan="3" Spacing="2">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding TimelineTitle}" />
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding TimelineSubtitle}" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding TimelineDurationText}" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Text="{Binding RuntimeTraceStatusText}" />
                                </StackPanel>
                                <TextBlock
                                    MaxWidth="720"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    MaxLines="2"
                                    Text="{Binding SequenceIntentText}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap"
                                    ToolTipService.ToolTip="{Binding SequenceIntentText}" />
                            </StackPanel>
                            <ComboBox
                                Grid.Row="1"
                                Grid.Column="1"
                                Header="Fase"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{Binding Phases}"
                                SelectedItem="{Binding SelectedPhase, Mode=TwoWay}" />
                            <ComboBox
                                Grid.Row="1"
                                Grid.Column="2"
                                Header="Sequenza"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{Binding Sequences}"
                                SelectedItem="{Binding SelectedSequence, Mode=TwoWay}" />
                        </Grid>
                        <Border
                            Grid.Row="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <views:FusionEncounterTimelineView DataContext="{Binding}" />
                        </Border>
                        <Border
                            Grid.Row="2"
                            Padding="14,10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <StackPanel Spacing="7">
                                <TextBlock
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Text="STEP SELEZIONATO" />
                                <ContentControl Content="{Binding SelectedTimelineStep}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate x:DataType="viewModels:FusionBossTimelineStepViewModel">
                                            <Grid ColumnSpacing="14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="86" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <TextBlock FontFamily="Consolas" Text="{x:Bind TimeText}" />
                                                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind KindText}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="3">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock
                                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                            Text="{x:Bind IconGlyph}" />
                                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind Detail}"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock
                                                        FontSize="10"
                                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                        Text="{x:Bind DataFlowText}"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock
                                                        FontFamily="Consolas"
                                                        FontSize="10"
                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                        Text="{x:Bind TechnicalText}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    FontFamily="Consolas"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind DurationText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>
                            </StackPanel>
                        </Border>
                        <Expander
                            Grid.Row="3"
                            VerticalAlignment="Top"
                            Header="{Binding TimelineStepListHeader}"
                            IsExpanded="False">
                            <Border
                                MaxHeight="330"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <ListView
                                    x:Name="TimelineListView"
                                    Padding="12,8"
                                    HorizontalContentAlignment="Stretch"
                                    ItemsSource="{Binding TimelineSteps}"
                                    SelectedItem="{Binding SelectedTimelineStep, Mode=TwoWay}"
                                    SelectionMode="Single">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:FusionBossTimelineStepViewModel">
                                            <Grid MinHeight="54" Padding="4,4" ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30" />
                                                    <ColumnDefinition Width="72" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    Text="{x:Bind PositionText}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    FontFamily="Consolas"
                                                    FontSize="11"
                                                    Text="{x:Bind TimeText}" />
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock
                                                            FontSize="10"
                                                            FontWeight="SemiBold"
                                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                            Text="{x:Bind CategoryText}" />
                                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            FontFamily="Consolas"
                                                            FontSize="10"
                                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                            Text="{x:Bind TechnicalId}" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind Detail}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="3"
                                                    VerticalAlignment="Center"
                                                    FontFamily="Consolas"
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind DurationText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Border>
                        </Expander>
                    </Grid>
                </TabViewItem>
                <TabViewItem
                    Header="Runtime"
                    HorizontalContentAlignment="Stretch"
                    IsClosable="False"
                    VerticalContentAlignment="Stretch">
                    <Grid Margin="0,10,0,0" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*" />
                                <ColumnDefinition Width="7*" />
                                <ColumnDefinition Width="9*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Grid.ColumnSpan="4"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="Runtime Review"
                                ToolTipService.ToolTip="Confronta previsione, telegraph e collisione senza aprire il trace completo." />
                            <ComboBox
                                Grid.Row="1"
                                Header="Fase"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{Binding Phases}"
                                SelectedItem="{Binding SelectedPhase, Mode=TwoWay}" />
                            <ComboBox
                                Grid.Row="1"
                                Grid.Column="1"
                                Header="Sequenza"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{Binding Sequences}"
                                SelectedItem="{Binding SelectedSequence, Mode=TwoWay}" />
                            <ComboBox
                                Grid.Row="1"
                                Grid.Column="2"
                                Header="Trace runtime"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{Binding RuntimeTraces}"
                                SelectedItem="{Binding SelectedRuntimeTrace, Mode=TwoWay}"
                                ToolTipService.ToolTip="{Binding SelectedRuntimeTrace.DetailText}" />
                            <Button
                                Grid.Row="1"
                                Grid.Column="3"
                                Margin="0,0,0,1"
                                VerticalAlignment="Bottom"
                                Click="RefreshRuntimeTraces_Click"
                                ToolTipService.ToolTip="Ricarica i trace generati dal playtest">
                                <FontIcon FontSize="14" Glyph="&#xE72C;" />
                            </Button>
                            <TextBlock
                                Grid.Row="2"
                                Grid.ColumnSpan="2"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{Binding RuntimeReviewSummaryText}"
                                TextTrimming="CharacterEllipsis" />
                            <CheckBox
                                Grid.Row="2"
                                Grid.Column="2"
                                Grid.ColumnSpan="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="Mostra anche allineati"
                                IsChecked="{Binding ShowAlignedRuntimeAttacks, Mode=TwoWay}" />
                        </Grid>

                        <Grid Grid.Row="1" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Padding="12,9"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <TextBlock
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                        Text="{Binding RuntimeAlignedCount}" />
                                    <TextBlock VerticalAlignment="Center" Text="Allineati" />
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Column="1"
                                Padding="12,9"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <TextBlock
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                        Text="{Binding RuntimeDriftCount}" />
                                    <TextBlock VerticalAlignment="Center" Text="Drift" />
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Column="2"
                                Padding="12,9"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <TextBlock
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        Text="{Binding RuntimeDivergentCount}" />
                                    <TextBlock VerticalAlignment="Center" Text="Divergenti" />
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Column="3"
                                Padding="12,9"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <TextBlock
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding RuntimeMissingCount}" />
                                    <TextBlock VerticalAlignment="Center" Text="Mancanti" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2" MinHeight="220" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*" />
                                <ColumnDefinition Width="7*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <Grid Padding="12,10" RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding RuntimeReviewListHeader}" />
                                    <ListView
                                        Grid.Row="1"
                                        Margin="0,4,0,0"
                                        HorizontalContentAlignment="Stretch"
                                        ItemsSource="{Binding RuntimeAttackComparisons}"
                                        SelectedItem="{Binding SelectedRuntimeAttack, Mode=TwoWay}"
                                        SelectionMode="Single">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="viewModels:FusionRuntimeAttackComparisonViewModel">
                                                <Grid MinHeight="76" Padding="3,5" ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        VerticalAlignment="Top"
                                                        FontSize="18"
                                                        FontWeight="SemiBold"
                                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                        Text="{x:Bind StatusGlyph}" />
                                                    <StackPanel Grid.Column="1" Spacing="3">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind SkillText}" />
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                FontSize="10"
                                                                FontWeight="SemiBold"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Text="{x:Bind StatusText}" />
                                                        </Grid>
                                                        <TextBlock
                                                            FontFamily="Consolas"
                                                            FontSize="11"
                                                            Text="{x:Bind FrameComparisonText}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            FontSize="11"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{x:Bind Summary}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <TextBlock
                                        Grid.Row="2"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{Binding RuntimeReviewEmptyText}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </Border>

                            <Border
                                Grid.Column="1"
                                Padding="16,14"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <Grid RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Confronto selezionato" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding RuntimeReviewSelectionHint}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ContentControl
                                        Grid.Row="1"
                                        Content="{Binding SelectedRuntimeAttack}"
                                        Visibility="{Binding HasSelectedRuntimeAttack, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ContentControl.ContentTemplate>
                                            <DataTemplate x:DataType="viewModels:FusionRuntimeAttackComparisonViewModel">
                                                <StackPanel Spacing="14">
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="2">
                                                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="{x:Bind SkillText}" />
                                                            <TextBlock
                                                                FontFamily="Consolas"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Text="{x:Bind StepText}" />
                                                        </StackPanel>
                                                        <Border
                                                            Grid.Column="1"
                                                            Padding="9,5"
                                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                            CornerRadius="6">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <TextBlock Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="{x:Bind StatusGlyph}" />
                                                                <TextBlock FontSize="11" FontWeight="SemiBold" Text="{x:Bind StatusText}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                    <StackPanel Spacing="5">
                                                        <TextBlock
                                                            FontSize="10"
                                                            FontWeight="SemiBold"
                                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                            Text="TIMING" />
                                                        <TextBlock FontFamily="Consolas" FontSize="12" Text="{x:Bind TimingDetailText}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <StackPanel Spacing="5">
                                                        <TextBlock
                                                            FontSize="10"
                                                            FontWeight="SemiBold"
                                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                            Text="GEOMETRIA" />
                                                        <TextBlock FontFamily="Consolas" FontSize="12" Text="{x:Bind GeometryDetailText}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <StackPanel Spacing="5">
                                                        <TextBlock
                                                            FontSize="10"
                                                            FontWeight="SemiBold"
                                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                            Text="ESITO" />
                                                        <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" />
                                                        <TextBlock
                                                            FontFamily="Consolas"
                                                            FontSize="10"
                                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                            Text="{x:Bind IdentifierText}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ContentControl.ContentTemplate>
                                    </ContentControl>
                                    <StackPanel
                                        Grid.Row="2"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        Visibility="{Binding HasSelectedRuntimeAttack, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding PreviewFrameText}" />
                                        <Button
                                            Click="OpenSelectedRuntimeInSequence_Click"
                                            Content="Apri nella Sequenza" />
                                        <Button
                                            Click="OpenSelectedRuntimeInArena_Click"
                                            Content="Mostra nell'Arena"
                                            Style="{ThemeResource AccentButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabViewItem>
                <TabViewItem
                    Header="Arena"
                    HorizontalContentAlignment="Stretch"
                    IsClosable="False"
                    VerticalContentAlignment="Stretch">
                    <Grid Margin="0,10,0,0" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Arena Preview" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding MapSummaryText}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="OpenArenaPreviewWindow_Click"
                                ToolTipService.ToolTip="Apre la preview in una finestra ridimensionabile separata">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon FontSize="14" Glyph="&#xE8A7;" />
                                    <TextBlock Text="{Binding ArenaPreviewWindowButtonText}" />
                                </StackPanel>
                            </Button>
                            <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    Header="Fase"
                                    DisplayMemberPath="DisplayName"
                                    ItemsSource="{Binding Phases}"
                                    SelectedItem="{Binding SelectedPhase, Mode=TwoWay}" />
                                <ComboBox
                                    Grid.Column="1"
                                    Header="Sequenza"
                                    DisplayMemberPath="DisplayName"
                                    ItemsSource="{Binding Sequences}"
                                    SelectedItem="{Binding SelectedSequence, Mode=TwoWay}" />
                                <ComboBox
                                    Grid.Column="2"
                                    Header="Trace runtime"
                                    DisplayMemberPath="DisplayName"
                                    ItemsSource="{Binding RuntimeTraces}"
                                    SelectedItem="{Binding SelectedRuntimeTrace, Mode=TwoWay}"
                                    ToolTipService.ToolTip="{Binding SelectedRuntimeTrace.DetailText}" />
                                <Button
                                    Grid.Column="3"
                                    Margin="0,0,0,1"
                                    VerticalAlignment="Bottom"
                                    Click="RefreshRuntimeTraces_Click"
                                    ToolTipService.ToolTip="Ricarica i trace generati dal playtest">
                                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                                </Button>
                            </Grid>
                            <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    Header="Arena"
                                    DisplayMemberPath="DisplayName"
                                    ItemsSource="{Binding Arenas}"
                                    SelectedItem="{Binding SelectedArena, Mode=TwoWay}"
                                    ToolTipService.ToolTip="{Binding SelectedArena.DisplayName}" />
                                <ComboBox
                                    Grid.Column="1"
                                    Header="Mappa"
                                    DisplayMemberPath="DisplayName"
                                    ItemsSource="{Binding Maps}"
                                    SelectedItem="{Binding SelectedMap, Mode=TwoWay}"
                                    ToolTipService.ToolTip="{Binding SelectedMap.DisplayName}" />
                            </Grid>
                            <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Text="{Binding RuntimeTraceStatusText}" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Text="{Binding RuntimeTraceErrorsText}" />
                            </StackPanel>
                        </Grid>
                        <Border
                            Grid.Row="1"
                            Background="#101218"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            MinHeight="260">
                            <Grid>
                                <Grid x:Name="EmbeddedArenaPreviewHost" />
                                <Grid
                                    x:Name="DetachedArenaPreviewPlaceholder"
                                    Padding="32"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    Visibility="Collapsed">
                                    <StackPanel
                                        MaxWidth="520"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="10">
                                        <FontIcon
                                            HorizontalAlignment="Center"
                                            FontSize="34"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Glyph="&#xE8A7;" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="20"
                                            FontWeight="SemiBold"
                                            Text="Hai spostato la preview in un'altra finestra"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="La selezione di arena e mappa resta sincronizzata con ZIAP Studio."
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                        <StackPanel
                                            Margin="0,8,0,0"
                                            HorizontalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <Button
                                                Click="ShowDetachedArenaPreview_Click"
                                                Content="Mostra finestra" />
                                            <Button
                                                Click="AttachArenaPreview_Click"
                                                Content="Riporta qui"
                                                Style="{ThemeResource AccentButtonStyle}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabViewItem>
            </TabView>

            <Border
                x:Name="EditorPanel"
                Grid.Column="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Visibility="Collapsed">
                <Grid Padding="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Inspector modifica" />
                        <TextBlock
                            FontFamily="Consolas"
                            FontSize="10"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{Binding EditorSelectionText}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" Margin="0,12,0,10" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="10">
                            <Expander Header="Fase" IsExpanded="True">
                                <StackPanel Margin="0,8,0,0" Spacing="7">
                                    <TextBox Header="Nome leggibile" Text="{Binding EditorPhaseDisplayName, Mode=TwoWay}" />
                                    <TextBox
                                        AcceptsReturn="True"
                                        Header="Riassunto"
                                        MinHeight="68"
                                        Text="{Binding EditorPhaseSummary, Mode=TwoWay}"
                                        TextWrapping="Wrap" />
                                    <TextBox
                                        AcceptsReturn="True"
                                        Header="Obiettivo giocatore"
                                        MinHeight="58"
                                        Text="{Binding EditorPhasePlayerGoal, Mode=TwoWay}"
                                        TextWrapping="Wrap" />
                                    <TextBox
                                        AcceptsReturn="True"
                                        Header="Intento di design"
                                        MinHeight="58"
                                        Text="{Binding EditorPhaseDesignerIntent, Mode=TwoWay}"
                                        TextWrapping="Wrap" />
                                    <Button
                                        HorizontalAlignment="Right"
                                        Click="ApplyPhaseEdits_Click"
                                        Content="Applica fase" />
                                </StackPanel>
                            </Expander>

                            <Expander
                                Header="Sequenza"
                                IsEnabled="{Binding CanEditSelectedSequence}"
                                IsExpanded="False">
                                <StackPanel Margin="0,8,0,0" Spacing="7">
                                    <TextBox Header="Nome leggibile" Text="{Binding EditorSequenceDisplayName, Mode=TwoWay}" />
                                    <TextBox
                                        AcceptsReturn="True"
                                        Header="Riassunto"
                                        MinHeight="68"
                                        Text="{Binding EditorSequenceSummary, Mode=TwoWay}"
                                        TextWrapping="Wrap" />
                                    <TextBox
                                        AcceptsReturn="True"
                                        Header="Obiettivo giocatore"
                                        MinHeight="58"
                                        Text="{Binding EditorSequencePlayerGoal, Mode=TwoWay}"
                                        TextWrapping="Wrap" />
                                    <TextBox
                                        AcceptsReturn="True"
                                        Header="Intento di design"
                                        MinHeight="58"
                                        Text="{Binding EditorSequenceDesignerIntent, Mode=TwoWay}"
                                        TextWrapping="Wrap" />
                                    <Button
                                        HorizontalAlignment="Right"
                                        Click="ApplySequenceEdits_Click"
                                        Content="Applica flusso" />
                                </StackPanel>
                            </Expander>

                            <Expander Header="Step selezionato · JSON avanzato" IsExpanded="False">
                                <StackPanel Margin="0,8,0,0" Spacing="7">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Modifica l'azione o il controllo reale. I campi non gestiti da ZIAP restano intatti."
                                        TextWrapping="Wrap" />
                                    <TextBox
                                        AcceptsReturn="True"
                                        FontFamily="Consolas"
                                        FontSize="11"
                                        IsEnabled="{Binding CanEditSelectedStep}"
                                        MinHeight="190"
                                        Text="{Binding EditorStepJson, Mode=TwoWay}"
                                        TextWrapping="NoWrap" />
                                    <Button
                                        HorizontalAlignment="Right"
                                        Click="ApplyStepJson_Click"
                                        Content="Applica step"
                                        IsEnabled="{Binding CanEditSelectedStep}" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Spacing="7">
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Text="{Binding EditorStatusText}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            FontSize="10"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding EditorDirtyText}" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="7">
                            <Button
                                Click="UndoEditor_Click"
                                Content="Annulla"
                                IsEnabled="{Binding EditorCanUndo}" />
                            <Button
                                Click="RedoEditor_Click"
                                Content="Ripristina"
                                IsEnabled="{Binding EditorCanRedo}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
