<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ZiapStudio.Views.FusionPuzzleDocumentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:puzzles="using:ZiapStudio.Core.Fusion.Puzzles"
    xmlns:views="using:ZiapStudio.Views">

    <Grid Padding="32,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock FontSize="30" FontWeight="SemiBold" Text="Fusion Puzzle" />
                    <Border
                        Padding="8,3"
                        VerticalAlignment="Center"
                        Background="{ThemeResource AccentFillColorSecondaryBrush}"
                        CornerRadius="5">
                        <TextBlock FontSize="10" FontWeight="SemiBold" Text="READ ONLY" />
                    </Border>
                </StackPanel>
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Legge definizioni, componenti mappa e comunicazioni runtime senza modificare il progetto." />
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="3">
                <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding WorkspaceStatusText}" />
                <TextBlock
                    HorizontalAlignment="Right"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{Binding VersionText}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,0" ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <Grid Padding="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Puzzle" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding PuzzleCountText}" />
                    </StackPanel>
                    <ListView
                        Grid.Row="1"
                        Margin="0,12,0,0"
                        HorizontalContentAlignment="Stretch"
                        ItemsSource="{Binding Puzzles}"
                        SelectedItem="{Binding SelectedPuzzle, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="puzzles:FusionPuzzleDefinition">
                                <StackPanel Padding="5,6" Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontFamily="Consolas"
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Id}" />
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{x:Bind SummaryText}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="2" Margin="0,10,0,0" Spacing="4">
                        <TextBlock FontSize="11" FontWeight="SemiBold" Text="SORGENTE" />
                        <TextBlock
                            FontFamily="Consolas"
                            FontSize="10"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding SourcePath}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{Binding SourcePath}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TabView
                Grid.Column="1"
                CanReorderTabs="False"
                HorizontalContentAlignment="Stretch"
                IsAddTabButtonVisible="False"
                TabWidthMode="SizeToContent"
                VerticalContentAlignment="Stretch">
                <TabViewItem Header="Grafo" IsClosable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Grid Margin="0,10,0,0" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Flusso di esecuzione" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Dal caricamento del database al cleanup dell'istanza." />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Text="{Binding SelectionStatusText}" />
                        </Grid>
                        <Border
                            Grid.Row="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <views:FusionPuzzleGraphView DataContext="{Binding}" />
                        </Border>
                        <Border
                            Grid.Row="2"
                            Padding="14,11"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock FontSize="10" FontWeight="SemiBold" Text="NODO SELEZIONATO" />
                                    <TextBlock FontWeight="SemiBold" Text="{Binding SelectedGraphNode.DisplayName}" />
                                    <TextBlock
                                        FontFamily="Consolas"
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding SelectedGraphNode.TechnicalId}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock FontSize="10" FontWeight="SemiBold" Text="ESEGUE" />
                                    <TextBlock Text="{Binding SelectedGraphNode.Execution}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock FontSize="10" FontWeight="SemiBold" Text="RISULTATO" />
                                    <TextBlock Text="{Binding SelectedGraphNode.Outcome}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabViewItem>

                <TabViewItem Header="Componenti" IsClosable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Grid Margin="0,10,0,0" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Padding="14"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Ruoli richiesti" />
                                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Confronto tra definizione e mappe." />
                                </StackPanel>
                                <ListView Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding Roles}" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="puzzles:FusionPuzzleRoleRequirement">
                                            <Grid Padding="3,6" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind StatusGlyph}" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Role}" />
                                                    <TextBlock FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind RequirementText}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind FoundText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <Expander Grid.Row="2" Header="Sorgenti e budget" IsExpanded="False">
                                    <ItemsControl Margin="0,7,0,0" ItemsSource="{Binding Sources}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="puzzles:FusionPuzzleSourceDefinition">
                                                <Grid Margin="0,3" ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock FontFamily="Consolas" Text="{x:Bind Key}" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind BudgetText}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </Grid>
                        </Border>
                        <Border
                            Grid.Column="1"
                            Padding="14"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Componenti trovati" />
                                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding ComponentCountText}" />
                                </StackPanel>
                                <ListView Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding Components}" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="puzzles:FusionPuzzleMapComponent">
                                            <Grid Padding="4,7" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="150" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Role}" />
                                                    <TextBlock FontSize="10" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="{x:Bind MetadataText}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{x:Bind EventText}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind MapText}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind Source}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>
                </TabViewItem>

                <TabViewItem Header="Lifecycle" IsClosable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Border
                        Margin="0,10,0,0"
                        Padding="14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Chiamate runtime" />
                                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding CallCountText}" />
                            </StackPanel>
                            <ListView Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding Calls}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="puzzles:FusionPuzzleCall">
                                        <Grid Padding="4,8" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontFamily="Consolas" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="{x:Bind OrderText}" />
                                            <TextBlock Grid.Column="1" FontSize="10" FontWeight="SemiBold" Text="{x:Bind KindText}" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind Caller}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="3" FontFamily="Consolas" FontSize="10" Text="{x:Bind Api}" TextWrapping="Wrap" />
                                            <StackPanel Grid.Column="4" Spacing="2">
                                                <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" />
                                                <TextBlock FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Outcome}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </TabViewItem>

                <TabViewItem Header="Requisiti" IsClosable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="14">
                                <Border Padding="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                                    <StackPanel Spacing="9">
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Dipendenze" />
                                        <ItemsControl ItemsSource="{Binding Dependencies}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="puzzles:FusionPuzzleDependency">
                                                    <Grid Margin="0,5" ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind DisplayName}" />
                                                            <TextBlock FontFamily="Consolas" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Id}" />
                                                            <TextBlock FontSize="10" Text="{x:Bind Purpose}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="{x:Bind StatusText}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border Padding="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                                    <StackPanel Spacing="9">
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Configurazione" />
                                        <ItemsControl ItemsSource="{Binding Settings}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="puzzles:FusionPuzzleSetting">
                                                    <Grid Margin="0,4" ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="110" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Group}" />
                                                        <TextBlock Grid.Column="1" FontFamily="Consolas" Text="{x:Bind Name}" />
                                                        <TextBlock Grid.Column="2" Text="{x:Bind Value}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="14">
                                <Border Padding="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                                    <StackPanel Spacing="9">
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Avvio da arena" />
                                        <ItemsControl ItemsSource="{Binding ArenaUsages}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="puzzles:FusionPuzzleArenaUsage">
                                                    <StackPanel Margin="0,5" Spacing="2">
                                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind DisplayName}" />
                                                        <TextBlock FontFamily="Consolas" FontSize="10" Text="{x:Bind ProviderInstanceId}" />
                                                        <TextBlock FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind MapText}" />
                                                        <TextBlock FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind RequirementText}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border Padding="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                                    <StackPanel Spacing="9">
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Diagnostica" />
                                        <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding DiagnosticsText}" />
                                        <ItemsControl ItemsSource="{Binding Diagnostics}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="puzzles:FusionPuzzleDiagnostic">
                                                    <StackPanel Margin="0,5" Spacing="2">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind SeverityText}" />
                                                            <TextBlock FontFamily="Consolas" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Code}" />
                                                        </StackPanel>
                                                        <TextBlock Text="{x:Bind Message}" TextWrapping="Wrap" />
                                                        <TextBlock FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Detail}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabViewItem>
            </TabView>
        </Grid>
    </Grid>
</UserControl>
