<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ZiapStudio.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:coreModels="using:ZiapStudio.Core.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:ZiapStudio.ViewModels"
    xmlns:views="using:ZiapStudio.Views"
    KeyboardAcceleratorPlacementMode="Hidden"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="S"
            Modifiers="Control"
            Invoked="SaveKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator
            Key="S"
            Modifiers="Control,Shift"
            Invoked="SaveAllKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator
            Key="Z"
            Modifiers="Control"
            Invoked="UndoKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator
            Key="Y"
            Modifiers="Control"
            Invoked="RedoKeyboardAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ProjectsPaneColumn" Width="292" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,0">
            <Grid>
            <Grid
                x:Name="ExpandedProjectsPane"
                Padding="20,20,16,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="Progetti" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Workspace Zenkaiverse"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Width="36"
                        Height="36"
                        AutomationProperties.Name="Comprimi pannello Progetti"
                        Click="ToggleProjectsPane_Click"
                        IsEnabled="{x:Bind ViewModel.HasProject, Mode=OneWay}"
                        ToolTipService.ToolTip="Comprimi pannello Progetti">
                        <FontIcon FontSize="14" Glyph="&#xE76B;" />
                    </Button>
                </Grid>

                <Button
                    Grid.Row="1"
                    Margin="0,22,0,24"
                    HorizontalAlignment="Stretch"
                    Click="OpenProject_Click"
                    IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE8B7;" />
                        <TextBlock Text="Apri progetto" />
                    </StackPanel>
                </Button>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Margin="4,0,0,10"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="RECENTI" />

                    <ListView
                        x:Name="RecentProjectsList"
                        Grid.Row="1"
                        HorizontalContentAlignment="Stretch"
                        IsItemClickEnabled="True"
                        ItemClick="RecentProjectsList_ItemClick"
                        ItemsSource="{x:Bind ViewModel.RecentProjects, Mode=OneWay}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="coreModels:ZiapProject">
                                <Grid Padding="8,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        Margin="0,2,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        FontSize="15"
                                        Glyph="&#xE8B7;" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Path}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <StackPanel Grid.Row="3" Margin="0,12,0,0" Spacing="8">
                    <Button
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="Account myZenkai">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontSize="17" Glyph="&#xE77B;" />
                            <StackPanel Grid.Column="1" Spacing="1">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.AccountDisplayName, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.AccountDetail, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" FontSize="11" Glyph="&#xE70D;" />
                        </Grid>
                        <Button.Flyout>
                            <Flyout Placement="RightEdgeAlignedTop">
                                <Grid Width="270">
                                    <StackPanel
                                        x:Name="ExpandedSignedOutAccountFlyout"
                                        Spacing="12"
                                        x:Load="{x:Bind ViewModel.IsNotAuthenticated, Mode=OneWay}">
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Account myZenkai" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Connetti Studio alla tua identità Zenkaiverse."
                                            TextWrapping="Wrap" />
                                        <Button
                                            HorizontalAlignment="Stretch"
                                            Click="SignIn_Click"
                                            Content="Accedi con myZenkai"
                                            IsEnabled="{x:Bind ViewModel.CanSignIn, Mode=OneWay}"
                                            Style="{StaticResource AccentButtonStyle}" />
                                    </StackPanel>
                                    <StackPanel
                                        x:Name="ExpandedSignedInAccountFlyout"
                                        Spacing="10"
                                        x:Load="{x:Bind ViewModel.IsAuthenticated, Mode=OneWay}">
                                        <TextBlock
                                            FontSize="18"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind ViewModel.AccountDisplayName, Mode=OneWay}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ViewModel.AccountDetail, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                        <Button
                                            HorizontalAlignment="Stretch"
                                            Click="SignOut_Click"
                                            Content="Disconnetti"
                                            IsEnabled="{x:Bind ViewModel.CanSignOut, Mode=OneWay}" />
                                    </StackPanel>
                                    <ProgressRing
                                        x:Name="ExpandedAuthenticationProgress"
                                        Width="22"
                                        Height="22"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        IsActive="True"
                                        x:Load="{x:Bind ViewModel.IsAuthenticationBusy, Mode=OneWay}" />
                                </Grid>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <TextBlock
                        Margin="4,0,0,0"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="ZIAP Studio 0.2.0" />
                </StackPanel>
            </Grid>

            <Grid
                x:Name="CompactProjectsPane"
                Padding="8,12,8,14"
                Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button
                    Width="44"
                    Height="44"
                    AutomationProperties.Name="Espandi pannello Progetti"
                    Click="ToggleProjectsPane_Click"
                    ToolTipService.ToolTip="Espandi Progetti e recenti">
                    <FontIcon FontSize="17" Glyph="&#xE700;" />
                </Button>
                <Button
                    Grid.Row="1"
                    Width="44"
                    Height="44"
                    Margin="0,8,0,0"
                    AutomationProperties.Name="Apri progetto"
                    Click="OpenProject_Click"
                    IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}"
                    ToolTipService.ToolTip="Apri progetto">
                    <FontIcon FontSize="17" Glyph="&#xE8B7;" />
                </Button>
                <Button
                    Grid.Row="2"
                    Width="44"
                    Height="44"
                    Padding="0"
                    AutomationProperties.Name="Project Overview"
                    Click="ProjectOverview_Click"
                    ToolTipService.ToolTip="Project Overview">
                    <Grid Width="44" Height="44">
                        <Border
                            x:Name="OverviewRailSelection"
                            Width="3"
                            Height="24"
                            HorizontalAlignment="Left"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="2"
                            x:Load="{x:Bind ViewModel.IsProjectOverviewSelected, Mode=OneWay}" />
                        <FontIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="17"
                            Glyph="&#xE80F;" />
                    </Grid>
                </Button>
                <Button
                    Grid.Row="3"
                    Width="44"
                    Height="44"
                    Padding="0"
                    AutomationProperties.Name="Remote Localization"
                    Click="OpenRemoteLocalizationDocument_Click"
                    ToolTipService.ToolTip="Remote Localization">
                    <Grid Width="44" Height="44">
                        <Border
                            x:Name="RemoteLocalizationRailSelection"
                            Width="3"
                            Height="24"
                            HorizontalAlignment="Left"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="2"
                            x:Load="{x:Bind ViewModel.IsRemoteLocalizationDocumentSelected, Mode=OneWay}" />
                        <FontIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="17"
                            Glyph="&#xE774;" />
                    </Grid>
                </Button>
                <Button
                    Grid.Row="4"
                    Width="44"
                    Height="44"
                    Padding="0"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="Pre-Flight"
                    Click="OpenPreflightDocument_Click"
                    ToolTipService.ToolTip="Pre-Flight">
                    <Grid Width="44" Height="44">
                        <Border
                            x:Name="PreflightRailSelection"
                            Width="3"
                            Height="24"
                            HorizontalAlignment="Left"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="2"
                            x:Load="{x:Bind ViewModel.IsPreflightDocumentSelected, Mode=OneWay}" />
                        <FontIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="17"
                            Glyph="&#xE9D9;" />
                    </Grid>
                </Button>
                <Button
                    Grid.Row="5"
                    Width="44"
                    Height="44"
                    AutomationProperties.Name="Account myZenkai"
                    ToolTipService.ToolTip="{x:Bind ViewModel.AccountDisplayName, Mode=OneWay}">
                    <FontIcon FontSize="17" Glyph="&#xE77B;" />
                    <Button.Flyout>
                        <Flyout Placement="RightEdgeAlignedBottom">
                            <Grid Width="270">
                                <StackPanel
                                    x:Name="CompactSignedOutAccountFlyout"
                                    Spacing="12"
                                    x:Load="{x:Bind ViewModel.IsNotAuthenticated, Mode=OneWay}">
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Account myZenkai" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Non connesso"
                                        TextWrapping="Wrap" />
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        Click="SignIn_Click"
                                        Content="Accedi con myZenkai"
                                        IsEnabled="{x:Bind ViewModel.CanSignIn, Mode=OneWay}"
                                        Style="{StaticResource AccentButtonStyle}" />
                                </StackPanel>
                                <StackPanel
                                    x:Name="CompactSignedInAccountFlyout"
                                    Spacing="10"
                                    x:Load="{x:Bind ViewModel.IsAuthenticated, Mode=OneWay}">
                                    <TextBlock
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind ViewModel.AccountDisplayName, Mode=OneWay}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.AccountDetail, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        Click="SignOut_Click"
                                        Content="Disconnetti"
                                        IsEnabled="{x:Bind ViewModel.CanSignOut, Mode=OneWay}" />
                                </StackPanel>
                                <ProgressRing
                                    x:Name="CompactAuthenticationProgress"
                                    Width="22"
                                    Height="22"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    IsActive="True"
                                    x:Load="{x:Bind ViewModel.IsAuthenticationBusy, Mode=OneWay}" />
                            </Grid>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <TextBlock
                    Grid.Row="6"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    FontSize="10"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="0.2.0" />
            </Grid>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid
                x:Name="EmptyState"
                Margin="48"
                MaxWidth="560"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                x:Load="{x:Bind ViewModel.HasNoProject, Mode=OneWay}">
                <StackPanel HorizontalAlignment="Center" Spacing="14">
                    <Border
                        Width="72"
                        Height="72"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource AccentFillColorSecondaryBrush}"
                        CornerRadius="20">
                        <FontIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="30"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            Glyph="&#xE8B7;" />
                    </Border>
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="30"
                        FontWeight="SemiBold"
                        Text="Apri il tuo primo progetto" />
                    <TextBlock
                        MaxWidth="500"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Seleziona una cartella con metadata ZIAP, package.json o un progetto RPG Maker riconoscibile."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Button
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        Click="OpenProject_Click"
                        IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE8B7;" />
                            <TextBlock Text="Scegli cartella" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid
                x:Name="ProjectWorkspace"
                Loaded="ProjectWorkspace_Loaded"
                x:Load="{x:Bind ViewModel.HasProject, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        x:Name="ProjectExplorerColumn"
                        Width="300"
                        MinWidth="220"
                        MaxWidth="550" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0"
                    SizeChanged="ProjectExplorerPane_SizeChanged">
                    <Grid Padding="14,22,10,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Margin="8,0,8,3"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="PROJECT EXPLORER" />
                        <Button
                            Grid.Row="1"
                            Margin="0,0,0,10"
                            Padding="8,4"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="ProjectOverview_Click"
                            ToolTipService.ToolTip="Apri Project Overview">
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{x:Bind ViewModel.ProjectExplorerTitle, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </Button>

                        <TreeView
                            Grid.Row="2"
                            ItemInvoked="ProjectExplorer_ItemInvoked"
                            ItemsSource="{x:Bind ViewModel.ProjectExplorerNodes, Mode=OneWay}"
                            SelectionMode="None">
                            <TreeView.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:ProjectExplorerItemViewModel">
                                    <TreeViewItem
                                        IsExpanded="{x:Bind IsExpanded}"
                                        ItemsSource="{x:Bind Children}"
                                        ToolTipService.ToolTip="{x:Bind Path}">
                                        <TreeViewItem.Content>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon FontSize="14" Glyph="{x:Bind IconGlyph}" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Text="{x:Bind Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </TreeViewItem.Content>
                                    </TreeViewItem>
                                </DataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Grid>
                </Border>

                <Border
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    AutomationProperties.Name="Ridimensiona Project Explorer"
                    Background="Transparent"
                    PointerCaptureLost="Splitter_PointerCaptureLost"
                    PointerMoved="ExplorerSplitter_PointerMoved"
                    PointerPressed="ExplorerSplitter_PointerPressed"
                    PointerReleased="Splitter_PointerReleased"
                    ToolTipService.ToolTip="Trascina per ridimensionare Project Explorer">
                    <Rectangle
                        Width="1"
                        HorizontalAlignment="Center"
                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TabView
                        x:Name="DocumentTabs"
                        CanReorderTabs="True"
                        CloseButtonOverlayMode="OnPointerOver"
                        IsAddTabButtonVisible="False"
                        SelectedItem="{x:Bind ViewModel.SelectedDocument, Mode=TwoWay}"
                        TabCloseRequested="DocumentTabs_TabCloseRequested"
                        TabItemsSource="{x:Bind ViewModel.OpenDocuments, Mode=OneWay}">
                        <TabView.TabItemTemplate>
                            <DataTemplate x:DataType="viewModels:DocumentTabViewModel">
                                <TabViewItem Header="{x:Bind Header, Mode=OneWay}" IsClosable="{x:Bind IsClosable}" />
                            </DataTemplate>
                        </TabView.TabItemTemplate>
                    </TabView>

                    <CommandBar
                        Grid.Row="1"
                        Padding="8,0"
                        Background="{ThemeResource LayerFillColorAltBrush}"
                        DefaultLabelPosition="Right"
                        IsDynamicOverflowEnabled="False">
                        <AppBarButton
                            x:Name="OverviewRefreshCommand"
                            AutomationProperties.Name="Verifica localizzazione remota"
                            Click="RefreshRemoteLocalization_Click"
                            IsEnabled="{x:Bind ViewModel.CanRefreshRemoteLocalization, Mode=OneWay}"
                            Label="Verifica remoto"
                            ToolTipService.ToolTip="Verifica le versioni pubblicate"
                            x:Load="{x:Bind ViewModel.IsProjectOverviewSelected, Mode=OneWay}">
                            <AppBarButton.Icon>
                                <FontIcon FontSize="14" Glyph="&#xE72C;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            x:Name="OverviewOpenRemoteCommand"
                            AutomationProperties.Name="Apri Remote Localization"
                            Click="OpenRemoteLocalizationDocument_Click"
                            Label="Remote Localization"
                            ToolTipService.ToolTip="Apri il documento Remote Localization"
                            x:Load="{x:Bind ViewModel.IsProjectOverviewSelected, Mode=OneWay}">
                            <AppBarButton.Icon>
                                <FontIcon FontSize="14" Glyph="&#xE774;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            x:Name="OverviewOpenFolderCommand"
                            AutomationProperties.Name="Apri cartella progetto"
                            Click="OpenFolder_Click"
                            Label="Apri cartella"
                            ToolTipService.ToolTip="Apri la cartella del progetto"
                            x:Load="{x:Bind ViewModel.IsProjectOverviewSelected, Mode=OneWay}">
                            <AppBarButton.Icon>
                                <FontIcon FontSize="14" Glyph="&#xE838;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            x:Name="OverviewOpenPreflightCommand"
                            AutomationProperties.Name="Apri Pre-Flight"
                            Click="OpenPreflightDocument_Click"
                            Label="Pre-Flight"
                            ToolTipService.ToolTip="Mostra l'analisi Pre-Flight"
                            x:Load="{x:Bind ViewModel.IsProjectOverviewSelected, Mode=OneWay}">
                            <AppBarButton.Icon>
                                <FontIcon FontSize="14" Glyph="&#xE9D9;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            x:Name="RemoteRefreshCommand"
                            AutomationProperties.Name="Verifica localizzazione remota"
                            Click="RefreshRemoteLocalization_Click"
                            IsEnabled="{x:Bind ViewModel.CanRefreshRemoteLocalization, Mode=OneWay}"
                            Label="Verifica ora"
                            ToolTipService.ToolTip="Aggiorna lo stato Remote Localization"
                            x:Load="{x:Bind ViewModel.IsRemoteLocalizationDocumentSelected, Mode=OneWay}">
                            <AppBarButton.Icon>
                                <FontIcon FontSize="14" Glyph="&#xE72C;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            x:Name="PreflightAnalyzeCommand"
                            AutomationProperties.Name="Analizza progetto"
                            Click="AnalyzePreflight_Click"
                            IsEnabled="{x:Bind ViewModel.CanAnalyzePreflight, Mode=OneWay}"
                            Label="Analizza ora"
                            ToolTipService.ToolTip="Esegui nuovamente il Pre-Flight"
                            x:Load="{x:Bind ViewModel.IsPreflightDocumentSelected, Mode=OneWay}">
                            <AppBarButton.Icon>
                                <FontIcon FontSize="14" Glyph="&#xE72C;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            x:Name="PreflightRestoreAllCommand"
                            AutomationProperties.Name="Ripristina tutte le eccezioni Pre-Flight"
                            Click="RestoreAllPreflight_Click"
                            Label="Ripristina tutte"
                            ToolTipService.ToolTip="Rimuovi tutte le eccezioni Pre-Flight"
                            x:Load="{x:Bind ViewModel.IsPreflightDocumentSelected, Mode=OneWay}">
                            <AppBarButton.Icon>
                                <FontIcon FontSize="14" Glyph="&#xE777;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            x:Name="PreflightCleanObsoleteCommand"
                            AutomationProperties.Name="Pulisci eccezioni obsolete"
                            Click="CleanObsoletePreflight_Click"
                            Label="Pulisci obsolete"
                            ToolTipService.ToolTip="Elimina manualmente le eccezioni senza problemi corrispondenti"
                            x:Load="{x:Bind ViewModel.IsPreflightDocumentSelected, Mode=OneWay}">
                            <AppBarButton.Icon>
                                <FontIcon FontSize="14" Glyph="&#xE74D;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            x:Name="FusionAudioAddEventCommand"
                            AutomationProperties.Name="Nuovo evento Fusion Audio"
                            Click="AddFusionAudioEvent_Click"
                            Label="Nuovo evento"
                            x:Load="{x:Bind ViewModel.IsFusionAudioDocumentSelected, Mode=OneWay}">
                            <AppBarButton.Icon>
                                <FontIcon FontSize="14" Glyph="&#xE710;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            x:Name="FusionBossAnalyzeCommand"
                            AutomationProperties.Name="Analizza Fusion Boss Battle"
                            Click="AnalyzePreflight_Click"
                            IsEnabled="{x:Bind ViewModel.CanAnalyzePreflight, Mode=OneWay}"
                            Label="Analizza"
                            ToolTipService.ToolTip="Esegui il Pre-Flight dei contratti boss battle"
                            x:Load="{x:Bind ViewModel.IsFusionBossDocumentSelected, Mode=OneWay}">
                            <AppBarButton.Icon>
                                <FontIcon FontSize="14" Glyph="&#xE9D9;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            x:Name="FusionBossOpenPreflightCommand"
                            AutomationProperties.Name="Apri Pre-Flight Fusion Boss Battle"
                            Click="OpenPreflightDocument_Click"
                            Label="Pre-Flight"
                            x:Load="{x:Bind ViewModel.IsFusionBossDocumentSelected, Mode=OneWay}">
                            <AppBarButton.Icon>
                                <FontIcon FontSize="14" Glyph="&#xE773;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            x:Name="FusionBossDocumentationCommand"
