                                                 <StackPanel Spacing="9">
                                                     <TextBlock FontWeight="SemiBold" Text="Disassemblaggio" />
                                                     <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                                     <ItemsControl ItemsSource="{Binding DisassemblyResults}">
                                                         <ItemsControl.ItemTemplate>
                                                             <DataTemplate x:DataType="viewModels:WeaponDisassemblyResultEditorViewModel">
                                                                 <Grid Margin="0,2" ColumnSpacing="8">
                                                                     <Grid.ColumnDefinitions>
                                                                         <ColumnDefinition Width="*" />
                                                                         <ColumnDefinition Width="66" />
                                                                         <ColumnDefinition Width="66" />
                                                                         <ColumnDefinition Width="76" />
                                                                         <ColumnDefinition Width="Auto" />
                                                                     </Grid.ColumnDefinitions>
                                                                     <ComboBox
                                                                         HorizontalAlignment="Stretch"
                                                                         DisplayMemberPath="DisplayName"
                                                                         IsTextSearchEnabled="True"
                                                                         ItemsSource="{x:Bind ResourceOptions}"
                                                                         SelectedItem="{x:Bind SelectedResource, Mode=TwoWay}"
                                                                         ToolTipService.ToolTip="{x:Bind RawResource}" />
                                                                     <NumberBox
                                                                         Grid.Column="1"
                                                                         Header="Min"
                                                                         Minimum="0"
                                                                         SpinButtonPlacementMode="Compact"
                                                                         Value="{x:Bind MinimumQuantity, Mode=TwoWay}" />
                                                                     <NumberBox
                                                                         Grid.Column="2"
                                                                         Header="Max"
                                                                         Minimum="0"
                                                                         SpinButtonPlacementMode="Compact"
                                                                         Value="{x:Bind MaximumQuantity, Mode=TwoWay}" />
                                                                     <NumberBox
                                                                         Grid.Column="3"
                                                                         Header="%"
                                                                         Maximum="100"
                                                                         Minimum="0"
                                                                         SpinButtonPlacementMode="Compact"
                                                                         Value="{x:Bind Probability, Mode=TwoWay}" />
                                                                     <Button
                                                                         Grid.Column="4"
                                                                         VerticalAlignment="Bottom"
                                                                         AutomationProperties.Name="Rimuovi risultato disassemblaggio"
                                                                         Click="RemoveDisassemblyResult_Click">
                                                                         <FontIcon FontSize="12" Glyph="&#xE74D;" />
                                                                     </Button>
                                                                 </Grid>
                                                             </DataTemplate>
                                                         </ItemsControl.ItemTemplate>
                                                     </ItemsControl>
                                                     <Button
                                                         HorizontalAlignment="Left"
                                                         Click="AddDisassemblyResult_Click"
                                                         Content="+ Aggiungi risultato" />
                                                 </StackPanel>

                                                         </StackPanel>
                                                     </PivotItem>
                                                     <PivotItem Header="Avanzate">
                                                         <StackPanel Spacing="18">
                                                 <StackPanel Spacing="9">
                                                     <TextBlock FontWeight="SemiBold" Text="Comportamento" />
                                                     <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                                     <CheckBox
                                                         Content="Non renderizzare l'icona oggetto"
                                                         IsChecked="{Binding HideItemIcon, Mode=TwoWay}" />
                                                 </StackPanel>

                                                 <StackPanel
                                                     Spacing="7"
                                                     Visibility="{Binding HasDiagnostics, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                     <TextBlock FontWeight="SemiBold" Text="Validazione" />
                                                     <ItemsControl ItemsSource="{Binding Diagnostics}">
                                                         <ItemsControl.ItemTemplate>
                                                             <DataTemplate x:DataType="viewModels:WeaponNotetagDiagnosticViewModel">
                                                                 <TextBlock Margin="0,2" TextWrapping="Wrap">
                                                                     <Run FontWeight="SemiBold" Text="{x:Bind Glyph}" />
                                                                     <Run Text="  " />
                                                                     <Run Text="{x:Bind Message}" />
                                                                 </TextBlock>
                                                             </DataTemplate>
                                                         </ItemsControl.ItemTemplate>
                                                     </ItemsControl>
                                                 </StackPanel>

                                                 <StackPanel Spacing="7">
                                                     <TextBlock FontWeight="SemiBold" Text="Sorgente" />
                                                     <TextBlock
                                                         FontSize="11"
                                                         Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                         Text="{Binding SourceSummary}"
                                                         TextWrapping="Wrap" />
                                                     <Expander Header="Mostra note raw" IsExpanded="False">
                                                         <TextBox
                                                             MaxHeight="280"
                                                             AcceptsReturn="True"
                                                             FontFamily="Consolas"
                                                             FontSize="11"
                                                             IsReadOnly="True"
                                                             Text="{Binding RawSource, Mode=OneWay}"
                                                             TextWrapping="NoWrap" />
                                                     </Expander>
                                                 </StackPanel>
                                                         </StackPanel>
                                                     </PivotItem>
                                                 </Pivot>
                                             </StackPanel>
                                         </Expander>
                                     </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <InfoBar
                Margin="24"
                VerticalAlignment="Top"
                Closed="ErrorInfoBar_Closed"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error"
                Title="Impossibile completare l'operazione" />
        </Grid>

        <Grid
            x:Name="BusyOverlay"
            Grid.ColumnSpan="2"
            Background="#33000000"
            x:Load="{x:Bind ViewModel.IsBusy, Mode=OneWay}">
            <Border
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="12">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <ProgressRing Width="24" Height="24" IsActive="True" />
                    <TextBlock VerticalAlignment="Center" Text="Lettura del progetto…" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
