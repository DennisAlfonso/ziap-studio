                                                         <TextBlock FontWeight="SemiBold" Text="Problemi Pre-Flight" />
                                                         <ItemsControl ItemsSource="{Binding PreflightIssues}">
                                                             <ItemsControl.ItemTemplate>
                                                                 <DataTemplate x:DataType="viewModels:PreflightIssueViewModel">
                                                                     <TextBlock Margin="0,2" TextWrapping="Wrap">
                                                                         <Run FontWeight="SemiBold" Text="{x:Bind Glyph}" />
                                                                         <Run Text="  " />
                                                                         <Run Text="{x:Bind Message}" />
                                                                     </TextBlock>
                                                                 </DataTemplate>
                                                             </ItemsControl.ItemTemplate>
                                                         </ItemsControl>
                                                     </StackPanel>
                                                 </Border>
                                                 <StackPanel Spacing="9">
                                                     <TextBlock FontWeight="SemiBold" Text="Identità e attacco" />
                                                     <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                                     <Grid ColumnSpacing="12" RowSpacing="8">
                                                         <Grid.ColumnDefinitions>
                                                             <ColumnDefinition Width="132" />
                                                             <ColumnDefinition Width="*" />
                                                         </Grid.ColumnDefinitions>
                                                         <Grid.RowDefinitions>
                                                             <RowDefinition Height="Auto" />
                                                             <RowDefinition Height="Auto" />
                                                             <RowDefinition Height="Auto" />
                                                             <RowDefinition Height="Auto" />
                                                             <RowDefinition Height="Auto" />
                                                         </Grid.RowDefinitions>
                                                         <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Famiglia" />
                                                         <ComboBox
                                                             Grid.Column="1"
                                                             HorizontalAlignment="Stretch"
                                                             DisplayMemberPath="DisplayName"
                                                             ItemsSource="{Binding WeaponFamilyOptions}"
                                                             SelectedItem="{Binding SelectedWeaponFamily, Mode=TwoWay}" />
                                                         <TextBlock Grid.Row="1" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Sottotipo" />
                                                         <ComboBox
                                                             Grid.Row="1"
                                                             Grid.Column="1"
                                                             HorizontalAlignment="Stretch"
                                                             DisplayMemberPath="DisplayName"
                                                             ItemsSource="{Binding WeaponSubtypeOptions}"
                                                             SelectedItem="{Binding SelectedWeaponSubtype, Mode=TwoWay}" />
                                                         <TextBlock Grid.Row="2" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Impugnatura" />
                                                         <NumberBox Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="2" SmallChange="1" SpinButtonPlacementMode="Inline" Value="{Binding Handedness, Mode=TwoWay}" />
                                                         <TextBlock Grid.Row="3" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Abilità attacco" />
                                                         <ComboBox
                                                             Grid.Row="3"
                                                             Grid.Column="1"
                                                             HorizontalAlignment="Stretch"
                                                             DisplayMemberPath="Label"
                                                             IsTextSearchEnabled="True"
                                                             ItemsSource="{Binding AttackSkillOptions}"
                                                             SelectedItem="{Binding SelectedAttackSkill, Mode=TwoWay}" />
                                                         <TextBlock Grid.Row="4" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Elemento attacco" />
                                                         <ComboBox
                                                             Grid.Row="4"
                                                             Grid.Column="1"
                                                             HorizontalAlignment="Stretch"
                                                             DisplayMemberPath="Label"
                                                             IsTextSearchEnabled="True"
                                                             ItemsSource="{Binding AttackElementOptions}"
                                                             SelectedItem="{Binding SelectedAttackElement, Mode=TwoWay}" />
                                                     </Grid>
                                                 </StackPanel>

                                                         </StackPanel>
                                                     </PivotItem>
                                                     <PivotItem Header="Combattimento">
                                                         <StackPanel Spacing="18">
                                                 <StackPanel Spacing="9">
                                                     <TextBlock FontWeight="SemiBold" Text="Profilo di combattimento" />
                                                     <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                                     <Border Padding="12" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8">
                                                         <StackPanel Spacing="4">
                                                             <TextBlock FontWeight="SemiBold" Text="ATTACCO BASE" />
                                                             <TextBlock Text="{Binding AttackSkillOriginText}" TextWrapping="Wrap" />
                                                             <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{Binding SkillAttackBehaviorText}" TextWrapping="Wrap" />
                                                             <Button
                                                                 Margin="0,5,0,0"
                                                                 HorizontalAlignment="Left"
                                                                 Click="OpenWeaponAttackSkill_Click"
                                                                 Content="Apri abilità →" />
                                                         </StackPanel>
                                                     </Border>
                                                     <ToggleSwitch Header="Sovrascrivi la formula danno per quest'arma" IsOn="{Binding HasDamageOverrides, Mode=TwoWay}" />
                                                     <Grid
                                                         ColumnSpacing="12"
                                                         RowSpacing="8"
                                                         Visibility="{Binding HasDamageOverrides, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                         <Grid.ColumnDefinitions>
                                                             <ColumnDefinition Width="*" />
                                                             <ColumnDefinition Width="*" />
                                                         </Grid.ColumnDefinitions>
                                                         <NumberBox Header="Potenza · moltiplicatore" Minimum="0" SmallChange="0.05" Value="{Binding DamageRate, Mode=TwoWay}" />
                                                         <NumberBox Grid.Column="1" Header="Potenza · bonus piatto" SmallChange="1" Value="{Binding FlatDamage, Mode=TwoWay}" />
                                                         <NumberBox Grid.Row="1" Header="Penetrazione difesa" Minimum="0" SmallChange="0.05" Value="{Binding DefenseRate, Mode=TwoWay}" />
                                                     </Grid>
                                                     <ToggleSwitch Header="Sovrascrivi cadenza e balistica per quest'arma" IsOn="{Binding HasAttackBehaviorOverrides, Mode=TwoWay}" />
                                                     <Grid
                                                         ColumnSpacing="12"
                                                         RowSpacing="8"
                                                         Visibility="{Binding HasAttackBehaviorOverrides, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                         <Grid.ColumnDefinitions>
                                                             <ColumnDefinition Width="*" />
                                                             <ColumnDefinition Width="*" />
                                                         </Grid.ColumnDefinitions>
                                                         <NumberBox Header="Cadenza · intervallo (s)" Minimum="0.01" NumberFormatter="{StaticResource TwoDecimalFormatter}" SmallChange="0.05" Value="{Binding AttackInterval, Mode=TwoWay}" />
                                                         <NumberBox Grid.Column="1" Header="Balistica · portata (tile)" Minimum="0.01" NumberFormatter="{StaticResource TwoDecimalFormatter}" SmallChange="0.25" Value="{Binding AttackRange, Mode=TwoWay}" />
                                                         <NumberBox Grid.Row="1" Header="Balistica · raggio impatto" Minimum="0" NumberFormatter="{StaticResource TwoDecimalFormatter}" SmallChange="0.05" Value="{Binding AttackRadius, Mode=TwoWay}" />
                                                         <NumberBox Grid.Row="1" Grid.Column="1" Header="Balistica · velocità" Minimum="0" NumberFormatter="{StaticResource TwoDecimalFormatter}" SmallChange="0.25" Value="{Binding ProjectileSpeed, Mode=TwoWay}" />
                                                         <NumberBox Grid.Row="2" Header="Balistica · raggio collider (px)" Minimum="0.01" SmallChange="1" Value="{Binding ProjectileColliderRadius, Mode=TwoWay}" />
                                                     </Grid>
                                                 </StackPanel>

                                                         </StackPanel>
                                                     </PivotItem>
                                                     <PivotItem
                                                         Header="Arma da fuoco"
                                                         Visibility="{Binding IsFirearm, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                         <StackPanel Spacing="18">
                                                 <StackPanel
                                                     Spacing="9"
                                                     Visibility="{Binding IsFirearm, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                     <TextBlock FontWeight="SemiBold" Text="Arma da fuoco" />
                                                     <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                                     <Grid ColumnSpacing="12" RowSpacing="8">
                                                         <Grid.ColumnDefinitions>
                                                             <ColumnDefinition Width="*" />
                                                             <ColumnDefinition Width="*" />
                                                         </Grid.ColumnDefinitions>
                                                         <Grid.RowDefinitions>
                                                             <RowDefinition Height="Auto" />
                                                             <RowDefinition Height="Auto" />
                                                             <RowDefinition Height="Auto" />
                                                             <RowDefinition Height="Auto" />
                                                         </Grid.RowDefinitions>
                                                         <NumberBox Header="Caricatore" Minimum="1" SmallChange="1" SpinButtonPlacementMode="Compact" Value="{Binding MagazineSize, Mode=TwoWay}" />
                                                         <NumberBox Grid.Column="1" Header="Ricarica (s)" Minimum="0" NumberFormatter="{StaticResource TwoDecimalFormatter}" SmallChange="0.05" Value="{Binding ReloadDuration, Mode=TwoWay}" />
                                                         <NumberBox Grid.Row="1" Header="Precisione %" Minimum="0" Maximum="100" SmallChange="1" Value="{Binding FirearmAccuracy, Mode=TwoWay}" />
                                                         <NumberBox Grid.Row="1" Grid.Column="1" Header="Stabilità %" Minimum="0" Maximum="100" SmallChange="1" Value="{Binding FirearmStability, Mode=TwoWay}" />
                                                         <NumberBox Grid.Row="2" Header="Maneggevolezza %" Minimum="0" Maximum="100" SmallChange="1" Value="{Binding FirearmHandling, Mode=TwoWay}" />
                                                         <NumberBox Grid.Row="2" Grid.Column="1" Header="Distanza mira min (tile)" Minimum="1" NumberFormatter="{StaticResource TwoDecimalFormatter}" SmallChange="0.25" Value="{Binding AimMinimumDistance, Mode=TwoWay}" />
                                                         <NumberBox Grid.Row="3" Header="Distanza mira max (tile)" Minimum="1" NumberFormatter="{StaticResource TwoDecimalFormatter}" SmallChange="0.25" Value="{Binding AimMaximumDistance, Mode=TwoWay}" />
                                                         <NumberBox Grid.Row="3" Grid.Column="1" Header="Movimento in mira ×" Minimum="0.01" Maximum="1" NumberFormatter="{StaticResource TwoDecimalFormatter}" SmallChange="0.05" Value="{Binding AimMovementMultiplier, Mode=TwoWay}" />
                                                     </Grid>
                                                 </StackPanel>

                                                         </StackPanel>
                                                     </PivotItem>
                                                     <PivotItem Header="Progressione">
                                                         <StackPanel Spacing="18">
                                                 <StackPanel Spacing="9">
                                                     <TextBlock FontWeight="SemiBold" Text="Progressione" />
                                                     <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                                     <Grid ColumnSpacing="12" RowSpacing="8">
                                                         <Grid.ColumnDefinitions>
                                                             <ColumnDefinition Width="132" />
                                                             <ColumnDefinition Width="*" />
                                                         </Grid.ColumnDefinitions>
                                                         <Grid.RowDefinitions>
                                                             <RowDefinition Height="Auto" />
                                                             <RowDefinition Height="Auto" />
                                                             <RowDefinition Height="Auto" />
                                                             <RowDefinition Height="Auto" />
                                                             <RowDefinition Height="Auto" />
                                                         </Grid.RowDefinitions>
                                                         <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Rarità" />
                                                         <ComboBox
                                                             Grid.Column="1"
                                                             HorizontalAlignment="Stretch"
                                                             DisplayMemberPath="DisplayName"
                                                             ItemsSource="{Binding RarityOptions}"
                                                             SelectedItem="{Binding SelectedRarity, Mode=TwoWay}" />
                                                         <TextBlock Grid.Row="1" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Livello richiesto" />
                                                         <NumberBox
                                                             Grid.Row="1"
                                                             Grid.Column="1"
                                                             Minimum="1"
                                                             SmallChange="1"
                                                             SpinButtonPlacementMode="Inline"
                                                             Value="{Binding RequiredLevel, Mode=TwoWay}" />
                                                         <TextBlock Grid.Row="2" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Livello massimo" />
                                                         <ToggleSwitch
                                                             Grid.Row="2"
                                                             Grid.Column="1"
                                                             Header="Override esplicito"
                                                             IsOn="{Binding HasMaximumLevelOverride, Mode=TwoWay}" />
                                                         <NumberBox
                                                             Grid.Row="3"
                                                             Grid.Column="1"
                                                             Minimum="1"
                                                             SmallChange="1"
                                                             SpinButtonPlacementMode="Inline"
                                                             Value="{Binding MaximumLevel, Mode=TwoWay}"
                                                             Visibility="{Binding HasMaximumLevelOverride, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                         <StackPanel Grid.Row="4" Grid.Column="1" Spacing="3">
                                                             <TextBlock
                                                                 FontSize="11"
                                                                 Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                 Text="{Binding AutomaticMaximumLevelText}" />
                                                             <TextBlock
                                                                 FontSize="11"
                                                                 Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                                 Text="{Binding MaximumLevelDiagnostic}"
                                                                 TextWrapping="Wrap"
                                                                 Visibility="{Binding HasMaximumLevelDiagnostic, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                         </StackPanel>
                                                     </Grid>
                                                 </StackPanel>

                                                         </StackPanel>
                                                     </PivotItem>
                                                     <PivotItem Header="Perk">
                                                         <StackPanel Spacing="18">
