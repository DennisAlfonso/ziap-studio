                                                         HorizontalAlignment="Stretch"
                                                         DisplayMemberPath="DisplayName"
                                                         IsTextSearchEnabled="True"
                                                         ItemsSource="{Binding LoreOptions}"
                                                         SelectedItem="{Binding SelectedLore, Mode=TwoWay}" />
                                                     <TextBlock
                                                         FontFamily="Consolas"
                                                         FontSize="11"
                                                         Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                         Text="{Binding LoreStatusText}"
                                                         TextWrapping="Wrap" />
