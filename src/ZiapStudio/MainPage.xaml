                                                 DataContext="{Binding AdvancedEditor}"
                                                 Spacing="18">
                                                 <Pivot>
                                                     <PivotItem Header="Panoramica">
                                                         <StackPanel Spacing="18">
                                                 <Border
                                                     Padding="12"
                                                     Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                     CornerRadius="8"
                                                     Visibility="{Binding HasPreflightIssues, Converter={StaticResource BooleanToVisibilityConverter}}">
