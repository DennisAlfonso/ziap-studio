                                                                                Maximum="{x:Bind Maximum}"
                                                                                Minimum="{x:Bind Minimum}"
                                                                                SmallChange="1"
                                                                                SpinButtonPlacementMode="Inline"
                                                                                Value="{x:Bind NumericValue, Mode=TwoWay}"
                                                                                x:Load="{x:Bind IsNumberEditor}" />
                                                                            <TextBox
                                                                                x:Name="TextEditor"
                                                                                HorizontalAlignment="Stretch"
                                                                                AutomationProperties.Name="{x:Bind EditorAutomationName}"
                                                                                Text="{x:Bind TextValue, Mode=TwoWay}"
                                                                                x:Load="{x:Bind IsTextEditor}" />
                                                                            <TextBox
                                                                                x:Name="MultilineTextEditor"
                                                                                MinHeight="88"
                                                                                HorizontalAlignment="Stretch"
                                                                                AcceptsReturn="True"
                                                                                AutomationProperties.Name="{x:Bind EditorAutomationName}"
                                                                                Text="{x:Bind TextValue, Mode=TwoWay}"
                                                                                TextWrapping="Wrap"
                                                                                x:Load="{x:Bind IsMultilineTextEditor}" />
                                                                            <ComboBox
                                                                                x:Name="ReferenceEditor"
                                                                                HorizontalAlignment="Stretch"
                                                                                AutomationProperties.Name="{x:Bind EditorAutomationName}"
                                                                                DisplayMemberPath="DisplayValue"
                                                                                IsTextSearchEnabled="True"
                                                                                ItemsSource="{x:Bind EditorOptions}"
                                                                                SelectedItem="{x:Bind SelectedReferenceOption, Mode=TwoWay}"
                                                                                x:Load="{x:Bind IsReferenceEditor}" />
                                                                            <HyperlinkButton
                                                                                x:Name="NavigateReferenceButton"
                                                                                Padding="0"
                                                                                HorizontalAlignment="Left"
                                                                                Click="ResolvedReference_Click"
                                                                                Content="{x:Bind DisplayValue}"
                                                                                ToolTipService.ToolTip="{x:Bind NavigationTarget}"
                                                                                x:Load="{x:Bind CanNavigate}" />
                                                                            <TextBlock
                                                                                x:Name="PlainResolvedValueText"
                                                                                IsTextSelectionEnabled="True"
                                                                                Text="{x:Bind DisplayValue}"
                                                                                TextWrapping="Wrap"
                                                                                x:Load="{x:Bind CannotNavigate}" />
                                                                             <TextBlock
                                                                                 x:Name="SecondaryValueText"
                                                                                Margin="0,3,0,0"
                                                                                FontSize="11"
                                                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                                Text="{x:Bind SecondaryText}"
                                                                                 TextWrapping="Wrap"
                                                                                 x:Load="{x:Bind HasSecondaryText}" />
                                                                             <StackPanel
                                                                                 x:Name="ConsoleManagedPanel"
                                                                                 Margin="0,9,0,0"
                                                                                 Spacing="5"
                                                                                 x:Load="{x:Bind IsConsoleManaged}">
                                                                                 <TextBlock
                                                                                     FontSize="11"
                                                                                     FontWeight="SemiBold"
                                                                                     Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                                                     Text="●  Gestito da ZIAP Console" />
                                                                                 <Button
                                                                                     x:Name="OpenLocalizationInConsoleButton"
                                                                                     Padding="10,5"
                                                                                     HorizontalAlignment="Left"
                                                                                     AutomationProperties.Name="{x:Bind ConsoleNavigationAutomationName}"
                                                                                     Click="OpenLocalizationInConsole_Click"
                                                                                     Content="Apri in Console →"
                                                                                     ToolTipService.ToolTip="{x:Bind ConsoleNavigationToolTip}" />
                                                                             </StackPanel>
                                                                             <Border
                                                                                x:Name="AssetPreviewBorder"
                                                                                Margin="0,8,0,0"
                                                                                Padding="6"
                                                                                HorizontalAlignment="Left"
                                                                                AutomationProperties.Name="{x:Bind AssetPreview.AccessibleName, Mode=OneWay}"
                                                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                                BorderThickness="1"
                                                                                CornerRadius="6"
                                                                                x:Load="{x:Bind HasAssetPreview, Mode=OneWay}">
                                                                                <Grid
                                                                                    Width="{x:Bind AssetPreview.ViewportWidth, Mode=OneWay}"
                                                                                    Height="{x:Bind AssetPreview.ViewportHeight, Mode=OneWay}">
                                                                                    <Grid.Clip>
                                                                                        <RectangleGeometry Rect="{x:Bind AssetPreview.ClipRect, Mode=OneWay}" />
                                                                                    </Grid.Clip>
                                                                                    <Image
                                                                                        Width="{x:Bind AssetPreview.ImageWidth, Mode=OneWay}"
                                                                                        Height="{x:Bind AssetPreview.ImageHeight, Mode=OneWay}"
                                                                                        HorizontalAlignment="Left"
                                                                                        VerticalAlignment="Top"
                                                                                        Source="{x:Bind AssetPreview.ImageSource, Mode=OneWay}"
                                                                                        Stretch="Fill">
                                                                                        <Image.RenderTransform>
                                                                                            <TranslateTransform
                                                                                                X="{x:Bind AssetPreview.OffsetX, Mode=OneWay}"
                                                                                                Y="{x:Bind AssetPreview.OffsetY, Mode=OneWay}" />
                                                                                        </Image.RenderTransform>
                                                                                    </Image>
                                                                                </Grid>
                                                                            </Border>
                                                                            <TextBlock
                                                                                x:Name="AssetDiagnosticText"
                                                                                Margin="0,5,0,0"
                                                                                AutomationProperties.Name="Diagnostica asset"
                                                                                FontSize="11"
                                                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                                                Text="{x:Bind AssetDiagnostic}"
                                                                                TextWrapping="Wrap"
                                                                                x:Load="{x:Bind HasAssetDiagnostic}" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Expander>
                                                </DataTemplate>
                                             </ItemsControl.ItemTemplate>
                                         </ItemsControl>
                                         <Expander
                                             Margin="0,2,0,8"
                                             Padding="0"
                                             HorizontalAlignment="Stretch"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Header="{Binding AdvancedEditor.HeaderText}"
                                             IsExpanded="{Binding AdvancedEditor.IsExpanded, Mode=TwoWay}"
                                             Visibility="{Binding HasAdvancedEditor, Converter={StaticResource BooleanToVisibilityConverter}}">
