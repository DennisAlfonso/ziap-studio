                            <AppBarButton.Icon>
                                <FontIcon FontSize="14" Glyph="&#xE9D9;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            x:Name="FusionAudioOpenFolderCommand"
                            AutomationProperties.Name="Apri cartella audio"
                            Click="OpenFusionAudioFolder_Click"
                            Label="Apri cartella"
                            x:Load="{x:Bind ViewModel.IsFusionAudioDocumentSelected, Mode=OneWay}">
                            <AppBarButton.Icon>
                                <FontIcon FontSize="14" Glyph="&#xE838;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            x:Name="RemoteOpenConsoleCommand"
                            AutomationProperties.Name="Apri Localization in Console"
                            Click="OpenRemoteLocalizationAreaInConsole_Click"
                            Label="Apri in Console"
                            ToolTipService.ToolTip="Apri l'area Localization di ZIAP Console"
                            x:Load="{x:Bind ViewModel.IsRemoteLocalizationDocumentSelected, Mode=OneWay}">
                            <AppBarButton.Icon>
                                <FontIcon FontSize="14" Glyph="&#xE8A7;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            x:Name="EditingUndoCommand"
                            AutomationProperties.Name="Annulla modifica"
                            Click="Undo_Click"
                            IsEnabled="{x:Bind ViewModel.CanUndo, Mode=OneWay}"
                            Label="Annulla"
                            ToolTipService.ToolTip="Annulla (Ctrl+Z)"
                            x:Load="{x:Bind ViewModel.IsEditingDocumentSelected, Mode=OneWay}">
                            <AppBarButton.Icon>
                                <FontIcon FontSize="14" Glyph="&#xE7A7;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            x:Name="EditingRedoCommand"
                            AutomationProperties.Name="Ripristina modifica"
                            Click="Redo_Click"
                            IsEnabled="{x:Bind ViewModel.CanRedo, Mode=OneWay}"
                            Label="Ripristina"
                            ToolTipService.ToolTip="Ripristina (Ctrl+Y)"
                            x:Load="{x:Bind ViewModel.IsEditingDocumentSelected, Mode=OneWay}">
                            <AppBarButton.Icon>
                                <FontIcon FontSize="14" Glyph="&#xE7A6;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarSeparator
                            x:Name="EditingCommandSeparator"
                            x:Load="{x:Bind ViewModel.IsEditingDocumentSelected, Mode=OneWay}" />
                        <AppBarButton
                            x:Name="EditingSaveCommand"
                            AutomationProperties.Name="Salva documento"
                            Click="SaveDocument_Click"
                            IsEnabled="{x:Bind ViewModel.CanSaveDocument, Mode=OneWay}"
                            Label="Salva"
                            ToolTipService.ToolTip="Salva (Ctrl+S)"
                            x:Load="{x:Bind ViewModel.IsEditingDocumentSelected, Mode=OneWay}">
                            <AppBarButton.Icon>
                                <FontIcon FontSize="14" Glyph="&#xE74E;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            x:Name="EditingSaveAllCommand"
                            AutomationProperties.Name="Salva tutti i documenti"
                            Click="SaveAll_Click"
                            IsEnabled="{x:Bind ViewModel.CanSaveAll, Mode=OneWay}"
                            Label="Salva tutto"
                            ToolTipService.ToolTip="Salva tutto (Ctrl+Shift+S)"
                            x:Load="{x:Bind ViewModel.IsEditingDocumentSelected, Mode=OneWay}">
                            <AppBarButton.Icon>
                                <FontIcon FontSize="14" Glyph="&#xEA35;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar>

                    <ScrollViewer
                        x:Name="ProjectOverviewDocument"
                        Grid.Row="2"
                        HorizontalScrollBarVisibility="Disabled"
                        x:Load="{x:Bind ViewModel.IsProjectOverviewSelected, Mode=OneWay}">
                        <Grid
                            MaxWidth="1400"
                            Padding="40,32"
                            HorizontalAlignment="Stretch"
                            RowSpacing="24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock
                                        FontSize="34"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind ViewModel.ProjectName, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        FontSize="15"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <Border
                                    Grid.Column="1"
                                    Margin="20,7,0,0"
                                    Padding="10,5"
                                    VerticalAlignment="Top"
                                    Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                    CornerRadius="10">
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind ViewModel.ProjectStateLabel, Mode=OneWay}" />
                                </Border>

                            </Grid>

                            <Border
                                x:Name="InitializationCard"
                                Grid.Row="1"
                                Padding="22"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                x:Load="{x:Bind ViewModel.NeedsInitialization, Mode=OneWay}">
                                <Grid ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="5">
                                        <TextBlock
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Text="Questo progetto non è ancora configurato per ZIAP Studio" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="L'inizializzazione crea un piccolo metadata condiviso nella cartella .ziap."
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Click="InitializeProject_Click"
                                        Content="Inizializza progetto ZIAP"
                                        IsEnabled="{x:Bind ViewModel.CanInitialize, Mode=OneWay}"
                                        Style="{StaticResource AccentButtonStyle}" />
                                </Grid>
                            </Border>

                            <Grid
                                x:Name="OverviewSections"
                                Grid.Row="2"
                                ColumnSpacing="24"
                                RowSpacing="24"
                                SizeChanged="OverviewSections_SizeChanged">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="OverviewPrimaryColumn" Width="*" />
                                    <ColumnDefinition x:Name="OverviewSectionGap" Width="0" />
                                    <ColumnDefinition x:Name="OverviewSecondaryColumn" Width="0" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border
                                    x:Name="RemoteLocalizationCard"
                                    Grid.ColumnSpan="3"
                                    Padding="22"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    x:Load="{x:Bind ViewModel.HasRemoteLocalizationCard, Mode=OneWay}">
                                    <StackPanel Spacing="18">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="4">
                                                <TextBlock
                                                    FontSize="16"
                                                    FontWeight="SemiBold"
                                                    Text="Localizzazione remota" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind ViewModel.RemoteLocalizationDocument.LastCheckedText, Mode=OneWay}" />
                                            </StackPanel>
                                            <ProgressRing
                                                x:Name="RemoteLocalizationProgress"
                                                Grid.Column="1"
                                                Width="20"
                                                Height="20"
                                                VerticalAlignment="Center"
                                                IsActive="True"
                                                x:Load="{x:Bind ViewModel.IsRemoteLocalizationChecking, Mode=OneWay}" />
                                        </Grid>

                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource RemoteSummaryTileStyle}">
                                                <StackPanel Spacing="2">
                                                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="{x:Bind ViewModel.RemoteLocalizationDocument.AlignedCount, Mode=OneWay}" />
                                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Allineati" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" Style="{StaticResource RemoteSummaryTileStyle}">
                                                <StackPanel Spacing="2">
                                                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="{x:Bind ViewModel.RemoteLocalizationDocument.DifferentCount, Mode=OneWay}" />
                                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Differenti" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Style="{StaticResource RemoteSummaryTileStyle}">
                                                <StackPanel Spacing="2">
                                                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="{x:Bind ViewModel.RemoteLocalizationDocument.OnlyLocalCount, Mode=OneWay}" />
                                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Solo locali" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="3" Style="{StaticResource RemoteSummaryTileStyle}">
                                                <StackPanel Spacing="2">
                                                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="{x:Bind ViewModel.RemoteLocalizationDocument.OnlyPublishedCount, Mode=OneWay}" />
                                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Solo remoti" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <StackPanel
                                            x:Name="RemoteRecentProblemsPanel"
                                            Spacing="8"
                                            x:Load="{x:Bind ViewModel.HasRemoteLocalizationRecentProblems, Mode=OneWay}">
                                            <TextBlock
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="PROBLEMI RECENTI" />
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.RemoteLocalizationRecentProblems, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="viewModels:RemoteLocalizationFileViewModel">
                                                        <Grid Padding="0,6" ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="1" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="{x:Bind StatusText}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind ViewModel.RemoteLocalizationMessage, Mode=OneWay}"
                                                TextWrapping="Wrap" />
                                            <Button
                                                Grid.Column="1"
                                                Click="OpenRemoteLocalizationDocument_Click"
                                                Content="Mostra tutti"
                                                Style="{StaticResource AccentButtonStyle}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border
                                    x:Name="PreflightCard"
                                    Grid.Row="1"
                                    Grid.ColumnSpan="3"
                                    Padding="22"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    x:Load="{x:Bind ViewModel.HasPreflightCard, Mode=OneWay}">
                                    <StackPanel Spacing="18">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="4">
                                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Pre-Flight" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind ViewModel.PreflightDocument.LastScanText, Mode=OneWay}" />
                                            </StackPanel>
                                            <ProgressRing
                                                x:Name="PreflightProgress"
                                                Grid.Column="1"
                                                Width="20"
                                                Height="20"
                                                VerticalAlignment="Center"
                                                IsActive="True"
                                                x:Load="{x:Bind ViewModel.IsPreflightScanning, Mode=OneWay}" />
                                        </Grid>

                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource RemoteSummaryTileStyle}">
                                                <StackPanel Spacing="2">
                                                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="{x:Bind ViewModel.PreflightDocument.ErrorCount, Mode=OneWay}" />
                                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Errori" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" Style="{StaticResource RemoteSummaryTileStyle}">
                                                <StackPanel Spacing="2">
                                                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="{x:Bind ViewModel.PreflightDocument.WarningCount, Mode=OneWay}" />
                                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Avvisi" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Style="{StaticResource RemoteSummaryTileStyle}">
                                                <StackPanel Spacing="2">
                                                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="{x:Bind ViewModel.PreflightDocument.IgnoredCount, Mode=OneWay}" />
                                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Ignorati" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <StackPanel
                                            x:Name="PreflightRecentIssuesPanel"
                                            Spacing="8"
                                            x:Load="{x:Bind ViewModel.PreflightDocument.HasRecentIssues, Mode=OneWay}">
                                            <TextBlock
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="PROBLEMI RECENTI" />
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.PreflightDocument.RecentIssues, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="viewModels:PreflightIssueViewModel">
                                                        <Grid Padding="0,5" ColumnSpacing="10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Glyph}" />
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind RecordText}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Message}" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind ViewModel.PreflightDocument.SummaryText, Mode=OneWay}"
                                                TextWrapping="Wrap" />
                                            <Button
                                                Grid.Column="1"
                                                Click="OpenPreflightDocument_Click"
                                                Content="Mostra tutti"
                                                Style="{StaticResource AccentButtonStyle}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <StackPanel
                                    x:Name="OverviewDetailsSection"
                                    Grid.Row="2"
                                    Grid.ColumnSpan="3"
                                    Padding="12,8,12,4"
                                    Spacing="14">
                                    <TextBlock
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Text="Dettagli progetto" />
                                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <Grid RowSpacing="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Style="{StaticResource MetadataLabelStyle}" Text="Nome progetto" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource MetadataValueStyle}" Text="{x:Bind ViewModel.ProjectName, Mode=OneWay}" />
                                    <TextBlock Grid.Row="1" Style="{StaticResource MetadataLabelStyle}" Text="Package" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource MetadataValueStyle}" Text="{x:Bind ViewModel.PackageName, Mode=OneWay}" />
                                    <TextBlock Grid.Row="2" Style="{StaticResource MetadataLabelStyle}" Text="Versione" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource MetadataValueStyle}" Text="{x:Bind ViewModel.ProjectVersion, Mode=OneWay}" />
                                    <TextBlock Grid.Row="3" Style="{StaticResource MetadataLabelStyle}" Text="Tipo progetto" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource MetadataValueStyle}" Text="{x:Bind ViewModel.ProjectType, Mode=OneWay}" />
                                    <TextBlock Grid.Row="4" Style="{StaticResource MetadataLabelStyle}" Text="Publisher" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource MetadataValueStyle}" Text="{x:Bind ViewModel.Publisher, Mode=OneWay}" />
                                    <TextBlock Grid.Row="5" Style="{StaticResource MetadataLabelStyle}" Text="Percorso" />
                                    <TextBlock
                                        Grid.Row="5"
                                        Grid.Column="1"
                                        IsTextSelectionEnabled="True"
                                        Style="{StaticResource MetadataValueStyle}"
                                        Text="{x:Bind ViewModel.ProjectPath, Mode=OneWay}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </ScrollViewer>

                    <Grid
                        x:Name="RemoteLocalizationDocument"
                        Grid.Row="2"
                        Padding="32,26"
                        DataContext="{x:Bind ViewModel.RemoteLocalizationDocument, Mode=OneWay}"
                        x:Load="{x:Bind ViewModel.IsRemoteLocalizationDocumentSelected, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock FontSize="30" FontWeight="SemiBold" Text="Remote Localization" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Confronta il workspace locale con lo stato pubblicato da ZIAP Console." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}">
                                    <Run Text="{Binding ProblemCount}" />
                                    <Run Text=" problemi" />
                                </TextBlock>
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding LastCheckedText}" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,22,0,18" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock><Run Text="✓ " /><Run Text="{Binding AlignedCount}" /><Run Text=" Allineati" /></TextBlock>
                            <TextBlock Grid.Column="1"><Run Text="≠ " /><Run Text="{Binding DifferentCount}" /><Run Text=" Differenti" /></TextBlock>
                            <TextBlock Grid.Column="2"><Run Text="↑ " /><Run Text="{Binding OnlyLocalCount}" /><Run Text=" Solo locali" /></TextBlock>
                            <TextBlock Grid.Column="3"><Run Text="↓ " /><Run Text="{Binding OnlyPublishedCount}" /><Run Text=" Solo remoti" /></TextBlock>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,0,0,16" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                PlaceholderText="Cerca lingua, file o stato…"
                                Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ComboBox
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                SelectedIndex="{Binding FilterIndex, Mode=TwoWay}">
                                <x:String>Tutti</x:String>
                                <x:String>Problemi</x:String>
                                <x:String>Allineati</x:String>
                                <x:String>Differenti</x:String>
                                <x:String>Solo locali</x:String>
                                <x:String>Solo remoti</x:String>
                            </ComboBox>
                            <TextBlock
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{Binding VisibleCountText}" />
                        </Grid>

                        <Border
                            Grid.Row="3"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="42" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid
                                    Padding="14,0"
                                    Background="{ThemeResource LayerFillColorAltBrush}"
                                    ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Lingua" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="File" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Text="Locale" />
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" FontWeight="SemiBold" Text="Pubblicato" />
                                    <TextBlock Grid.Column="4" VerticalAlignment="Center" FontWeight="SemiBold" Text="Stato" />
                                    <TextBlock Grid.Column="5" VerticalAlignment="Center" FontWeight="SemiBold" Text="Azioni" />
                                </Grid>
                                <ListView
                                    Grid.Row="1"
                                    HorizontalContentAlignment="Stretch"
                                    ItemsSource="{Binding VisibleFiles}"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:RemoteLocalizationFileViewModel">
                                            <Grid Padding="14,10" ColumnSpacing="14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Bind Locale}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Text="{x:Bind File}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTipService.ToolTip="{x:Bind VersionText}" />
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12" Text="{x:Bind LocalChecksumText}" />
                                                <TextBlock Grid.Column="3" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12" Text="{x:Bind PublishedChecksumText}" />
                                                <TextBlock
                                                    Grid.Column="4"
                                                    VerticalAlignment="Center"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                    Text="{x:Bind StatusText}" />
                                                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6">
                                                    <Button
                                                        x:Name="RemoteDocumentCompareButton"
                                                        Click="CompareRemoteLocalization_Click"
                                                        Content="Confronta"
                                                        x:Load="{x:Bind CanCompare}" />
                                                    <Button
                                                        x:Name="RemoteDocumentSynchronizeButton"
                                                        Click="SynchronizeRemoteLocalization_Click"
                                                        Content="{x:Bind DocumentSynchronizeLabel}"
                                                        Style="{StaticResource AccentButtonStyle}"
                                                        x:Load="{x:Bind CanSynchronize}" />
                                                    <Button
                                                        AutomationProperties.Name="Apri in Console"
                                                        Click="OpenRemoteLocalizationInConsole_Click"
                                                        ToolTipService.ToolTip="{x:Bind ConsoleNavigationToolTip}">
                                                        <FontIcon FontSize="13" Glyph="&#xE8A7;" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid
                        x:Name="PreflightDocument"
                        Grid.Row="2"
                        Padding="32,26"
                        DataContext="{x:Bind ViewModel.PreflightDocument, Mode=OneWay}"
                        x:Load="{x:Bind ViewModel.IsPreflightDocumentSelected, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock FontSize="30" FontWeight="SemiBold" Text="Pre-Flight" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Controlla la coerenza semantica del progetto prima di test, build e release." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Text="{Binding SummaryText}" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding LastScanText}" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,22,0,18" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock><Run Text="● " /><Run Text="{Binding ErrorCount}" /><Run Text=" Errori" /></TextBlock>
                            <TextBlock Grid.Column="1"><Run Text="▲ " /><Run Text="{Binding WarningCount}" /><Run Text=" Avvisi" /></TextBlock>
                            <TextBlock Grid.Column="2"><Run Text="○ " /><Run Text="{Binding IgnoredCount}" /><Run Text=" Ignorati" /></TextBlock>
                            <TextBlock Grid.Column="3"><Run Text="◇ " /><Run Text="{Binding ObsoleteCount}" /><Run Text=" Obsoleti" /></TextBlock>
                            <ComboBox
                                Grid.Column="4"
                                Width="180"
                                HorizontalAlignment="Right"
                                ItemsSource="{Binding ScopeOptions}"
                                SelectedItem="{Binding SelectedScope, Mode=TwoWay}" />
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,0,0,16" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                PlaceholderText="Cerca record, evento, regola o messaggio…"
                                Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ComboBox
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                SelectedIndex="{Binding FilterIndex, Mode=TwoWay}">
                                <x:String>Tutti</x:String>
                                <x:String>Errori</x:String>
                                <x:String>Avvisi</x:String>
                                <x:String>Ignorati</x:String>
                                <x:String>Obsoleti</x:String>
                            </ComboBox>
                            <TextBlock
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{Binding VisibleCountText}" />
                        </Grid>

                        <Border
                            Grid.Row="3"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <ListView
                                HorizontalContentAlignment="Stretch"
                                ItemsSource="{Binding VisibleItems}"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:PreflightIssueViewModel">
                                        <Grid Padding="16,13" ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                VerticalAlignment="Top"
                                                FontSize="17"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind Glyph}" />
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind RecordText}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Message}" TextWrapping="Wrap" />
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    Text="{x:Bind SuppressionText}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                                <Button
                                                    Click="OpenPreflightIssue_Click"
                                                    Content="Apri"
                                                    Visibility="{x:Bind CanOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <Button
                                                    Click="IgnorePreflightIssue_Click"
                                                    Content="Ignora"
                                                    Visibility="{x:Bind CanIgnore, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <Button
                                                    Click="RestorePreflightIssue_Click"
                                                    Content="Ripristina"
                                                    Visibility="{x:Bind CanRestore, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                    </Grid>

                    <Grid
                        x:Name="FusionAudioDocument"
                        Grid.Row="2"
                        Padding="32,26"
                        DataContext="{x:Bind ViewModel.ActiveFusionAudioDocument, Mode=OneWay}"
                        x:Load="{x:Bind ViewModel.IsFusionAudioDocumentSelected, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock FontSize="30" FontWeight="SemiBold" Text="Fusion Audio" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Catalogo semantico degli effetti sonori di Fusion: Hexella Dive." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="14">
                                <TextBlock Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="{Binding PluginStatusText}" />
                                <TextBlock Text="{Binding CatalogStatusText}" />
                                <TextBlock Text="{Binding EventCountText}" />
                                <TextBlock Text="{Binding AssetCountText}" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,22,0,0" ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <Grid Padding="14">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBox
                                        PlaceholderText="Cerca evento o categoria…"
                                        Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <ListView
                                        Grid.Row="1"
                                        Margin="0,12,0,0"
                                        HorizontalContentAlignment="Stretch"
                                        IsItemClickEnabled="True"
                                        ItemClick="FusionAudioEvent_ItemClick"
                                        ItemsSource="{Binding VisibleEntries}"
                                        SelectedItem="{Binding SelectedEntry, Mode=OneWay}"
                                        SelectionChanged="FusionAudioEvent_SelectionChanged"
                                        SelectionMode="Single">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="viewModels:FusionAudioEntryViewModel">
                                                <StackPanel Padding="5,4" Spacing="2">
                                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind EventId, Mode=OneWay}" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                        Text="{x:Bind Category, Mode=OneWay}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Border>

                            <Border
                                Grid.Column="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <ScrollViewer Padding="22,18">
                                    <StackPanel
                                        DataContext="{Binding SelectedEntry}"
                                        Spacing="18">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <NumberBox
                                                Header="Volume master"
                                                Maximum="1"
                                                Minimum="0"
                                                SmallChange="0.05"
                                                SpinButtonPlacementMode="Compact"
                                                Value="{Binding DataContext.MasterVolume, ElementName=FusionAudioDocument, Mode=TwoWay}" />
                                            <NumberBox
                                                Grid.Column="1"
                                                Header="Volume categoria"
                                                Maximum="1"
                                                Minimum="0"
                                                SmallChange="0.05"
                                                SpinButtonPlacementMode="Compact"
                                                Value="{Binding DataContext.SelectedCategoryVolume, ElementName=FusionAudioDocument, Mode=TwoWay}" />
                                        </Grid>
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox
                                                Header="Evento"
                                                LostFocus="FusionAudioIdentity_LostFocus"
                                                Text="{Binding EventId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox
                                                Grid.Column="1"
                                                Header="Categoria"
                                                LostFocus="FusionAudioIdentity_LostFocus"
                                                Text="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>

                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox
                                                Header="Sorgente"
                                                HorizontalAlignment="Stretch"
                                                ItemsSource="{Binding SourceKindOptions}"
                                                SelectedIndex="{Binding SourceKindIndex, Mode=OneWay}"
                                                DropDownClosed="FusionAudioSourceKind_DropDownClosed" />
                                            <ComboBox
                                                Grid.Column="1"
                                                Header="System Sound slot"
                                                HorizontalAlignment="Stretch"
                                                ItemsSource="{Binding SystemSlotOptions}"
                                                SelectedIndex="{Binding SystemSlotIndex, Mode=OneWay}"
                                                DropDownClosed="FusionAudioSystemSlot_DropDownClosed"
                                                Visibility="{Binding IsSystemSoundSource, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </Grid>

                                        <StackPanel
                                            Spacing="9"
                                            Visibility="{Binding IsFileSource, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid>
                                                <TextBlock FontWeight="SemiBold" Text="Varianti" />
                                                <Button
                                                    HorizontalAlignment="Right"
                                                    Click="AddFusionAudioVariant_Click"
                                                    Content="+ Aggiungi" />
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Variants}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="viewModels:FusionAudioVariantViewModel">
                                                        <Grid Margin="0,3" ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <AutoSuggestBox
                                                                AutomationProperties.HelpText="Freccette per scorrere, Invio per selezionare, Spazio per riprodurre"
                                                                AutomationProperties.Name="Selettore file audio"
                                                                GotFocus="FusionAudioFileSelector_GotFocus"
                                                                MaxSuggestionListHeight="420"
                                                                PlaceholderText="{Binding DataContext.AudioFileSelectorPlaceholder, ElementName=FusionAudioDocument}"
                                                                PreviewKeyDown="FusionAudioFileSelector_PreviewKeyDown"
                                                                QuerySubmitted="FusionAudioFileSelector_QuerySubmitted"
                                                                SuggestionChosen="FusionAudioFileSelector_SuggestionChosen"
                                                                Text="{x:Bind File, Mode=OneWay}"
                                                                TextChanged="FusionAudioFileSelector_TextChanged"
                                                                TextMemberPath="CatalogPath"
                                                                UpdateTextOnSelect="False">
                                                                <AutoSuggestBox.QueryIcon>
                                                                    <SymbolIcon Symbol="Find" />
                                                                </AutoSuggestBox.QueryIcon>
                                                                <AutoSuggestBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="viewModels:FusionAudioFileOptionViewModel">
                                                                        <Grid MinWidth="520" Padding="3" ColumnSpacing="12">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <StackPanel Spacing="2">
                                                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind DisplayName}" />
                                                                                <TextBlock
                                                                                    FontSize="11"
                                                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                                    Text="{x:Bind DetailText}" />
                                                                            </StackPanel>
                                                                            <Button
                                                                Grid.Column="1"
                                                                                AutomationProperties.Name="Riproduci asset grezzo"
                                                                                Click="PreviewFusionAudioFile_Click"
                                                                                ToolTipService.ToolTip="Riproduci asset grezzo (Spazio)">
                                                                                <FontIcon FontSize="12" Glyph="&#xE768;" />
                                                                            </Button>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </AutoSuggestBox.ItemTemplate>
                                                            </AutoSuggestBox>
                                                            <Button Grid.Column="1" Click="PlayFusionAudioVariant_Click" ToolTipService.ToolTip="Riproduci asset grezzo selezionato (Spazio)">
                                                                <FontIcon FontSize="12" Glyph="&#xE768;" />
                                                            </Button>
                                                            <Button Grid.Column="2" Click="RemoveFusionAudioVariant_Click" ToolTipService.ToolTip="Rimuovi variante">
                                                                <FontIcon FontSize="12" Glyph="&#xE74D;" />
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Text="↑/↓ scorri  ·  Invio seleziona  ·  Spazio riproduce l'asset grezzo" />
                                        </StackPanel>

                                        <Border
                                            Padding="12,9"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="6"
                                            DataContext="{Binding DataContext, ElementName=FusionAudioDocument}"
                                            Visibility="{Binding HasLastPlayback, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel Spacing="2">
                                                <TextBlock
                                                    FontSize="10"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                    Text="ULTIMA RIPRODUZIONE EVENTO" />
                                                <TextBlock FontWeight="SemiBold" Text="{Binding LastPlaybackFileText}" />
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding LastPlaybackSettingsText}" />
                                            </StackPanel>
                                        </Border>

                                        <Grid ColumnSpacing="12" RowSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <NumberBox Header="Volume" Maximum="100" Minimum="0" SpinButtonPlacementMode="Compact" Value="{Binding Volume, Mode=TwoWay}" />
                                            <NumberBox Grid.Column="1" Header="Pitch minimo" Maximum="150" Minimum="50" SpinButtonPlacementMode="Compact" Value="{Binding PitchMin, Mode=TwoWay}" />
                                            <NumberBox Grid.Column="2" Header="Pitch massimo" Maximum="150" Minimum="50" SpinButtonPlacementMode="Compact" Value="{Binding PitchMax, Mode=TwoWay}" />
                                            <NumberBox Grid.Row="1" Header="Pan" Maximum="100" Minimum="-100" SpinButtonPlacementMode="Compact" Value="{Binding Pan, Mode=TwoWay}" />
                                            <NumberBox Grid.Row="1" Grid.Column="1" Header="Cooldown (ms)" Minimum="0" SpinButtonPlacementMode="Compact" Value="{Binding Cooldown, Mode=TwoWay}" />
                                            <CheckBox Grid.Row="1" Grid.Column="2" VerticalAlignment="Bottom" Content="Anti-ripetizione" IsChecked="{Binding AntiRepeat, Mode=TwoWay}" />
                                        </Grid>

                                        <Expander Header="Diagnostica catalogo" IsExpanded="False">
                                            <ItemsControl DataContext="{Binding DataContext, ElementName=FusionAudioDocument}" ItemsSource="{Binding Diagnostics}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="viewModels:FusionAudioDiagnosticViewModel">
                                                        <TextBlock Margin="0,3" TextWrapping="Wrap">
                                                            <Run FontWeight="SemiBold" Text="{x:Bind Glyph}" />
                                                            <Run Text="  " />
                                                            <Run Text="{x:Bind Message}" />
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>

                    <views:FusionBossDocumentView
                        x:Name="FusionBossDocument"
                        Grid.Row="2"
                        DataContext="{x:Bind ViewModel.ActiveFusionBossDocument, Mode=OneWay}"
                        x:Load="{x:Bind ViewModel.IsFusionBossDocumentSelected, Mode=OneWay}" />
                    <views:FusionPuzzleDocumentView
                        x:Name="FusionPuzzleDocument"
                        Grid.Row="2"
                        DataContext="{x:Bind ViewModel.ActiveFusionPuzzleDocument, Mode=OneWay}"
                        x:Load="{x:Bind ViewModel.IsFusionPuzzleDocumentSelected, Mode=OneWay}" />
                    <Grid
                        x:Name="DatabaseDocument"
                        Grid.Row="2"
                        Padding="32,26"
                        DataContext="{x:Bind ViewModel.ActiveDatabaseDocument, Mode=OneWay}"
                        Loaded="DatabaseDocument_Loaded"
                        x:Load="{x:Bind ViewModel.IsDatabaseDocumentSelected, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock FontSize="30" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding SourcePath}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                Margin="20,7,0,0"
                                HorizontalAlignment="Right"
                                Spacing="2">
                                <Button
                                    Margin="0,0,0,6"
                                    HorizontalAlignment="Right"
                                    Click="CreateWeapon_Click"
                                    Content="+ Nuova arma"
                                    IsEnabled="{Binding CanCreateWeapon}"
                                    Visibility="{Binding IsWeaponDatabase, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Text="{Binding ChangeCountText}" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding FilteredCountText}" />
                            </StackPanel>
                        </Grid>

                        <TextBox
                            Grid.Row="1"
                            Width="360"
                            Margin="0,22,0,18"
                            HorizontalAlignment="Left"
                            Header="Cerca nel database"
                            PlaceholderText="ID o nome…"
                            Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition
                                    x:Name="DatabaseListColumn"
                                    Width="460"
                                    MinWidth="360" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" MinWidth="300" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                SizeChanged="DatabaseListPane_SizeChanged">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="42" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <ItemsControl
                                        Padding="14,0"
                                        Background="{ThemeResource LayerFillColorAltBrush}"
                                        ItemsSource="{Binding Columns}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    Width="{Binding Width}"
                                                    VerticalAlignment="Center"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding DisplayName}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ListView
                                        Grid.Row="1"
                                        HorizontalContentAlignment="Stretch"
                                        ItemsSource="{Binding FilteredEntries}"
                                        SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                                        SelectionMode="Single">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="viewModels:RpgMakerDatabaseRowViewModel">
                                                <Grid>
                                                    <ItemsControl Padding="14,8" ItemsSource="{x:Bind Cells}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="viewModels:RpgMakerDatabaseCellViewModel">
                                                                <TextBlock
                                                                    Width="{x:Bind Width}"
                                                                    Text="{x:Bind Value, Mode=OneWay}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Border
                                                        Margin="0,0,8,0"
                                                        Padding="7,2"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                        CornerRadius="8"
                                                        ToolTipService.ToolTip="{x:Bind PreflightToolTip, Mode=OneWay}"
                                                        Visibility="{x:Bind HasPreflightIssues, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock
                                                            FontSize="11"
                                                            FontWeight="SemiBold"
                                                            Text="{x:Bind PreflightMarker, Mode=OneWay}" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Border>

                            <Border
                                Grid.Column="1"
                                Margin="1,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                AutomationProperties.Name="Ridimensiona lista e Inspector"
                                Background="Transparent"
                                PointerCaptureLost="Splitter_PointerCaptureLost"
                                PointerMoved="DatabaseSplitter_PointerMoved"
                                PointerPressed="DatabaseSplitter_PointerPressed"
                                PointerReleased="Splitter_PointerReleased"
                                ToolTipService.ToolTip="Trascina per ridimensionare lista e Inspector">
                                <Rectangle
                                    Width="1"
                                    HorizontalAlignment="Center"
                                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            </Border>

                            <Border
                                Grid.Column="2"
                                Margin="12,0,0,0"
