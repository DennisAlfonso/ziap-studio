<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ZiapStudio.Dialogs.FusionArenaPlaytestSetupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    CloseButtonText="Annulla">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">760</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer MaxHeight="720" VerticalScrollBarVisibility="Auto">
        <StackPanel Width="660" Spacing="16">
            <TextBlock
                x:Name="ArenaTextBlock"
                FontSize="16"
                FontWeight="SemiBold"
                TextWrapping="Wrap" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Il profilo viene ricordato per questa arena e per questo progetto. Ogni avvio crea una nuova partita: salvataggi e progressione storia non vengono usati."
                TextWrapping="Wrap" />

            <InfoBar
                x:Name="ValidationInfoBar"
                IsClosable="False"
                IsOpen="False"
                Severity="Error" />

            <ComboBox
                x:Name="RuntimeComboBox"
                HorizontalAlignment="Stretch"
                Header="Runtime RPG Maker MZ"
                IsEditable="True"
                PlaceholderText="Percorso di nw.exe"
                ToolTipService.ToolTip="Runtime NW.js incluso in RPG Maker MZ. Puoi incollare manualmente un altro percorso." />

            <Border
                Padding="14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <ComboBox
                        x:Name="ModeComboBox"
                        HorizontalAlignment="Stretch"
                        DisplayMemberPath="DisplayName"
                        Header="Metodo d'ingresso"
                        SelectionChanged="ModeComboBox_SelectionChanged" />
                    <TextBlock
                        x:Name="ModeDescriptionTextBlock"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox
                    x:Name="MapComboBox"
                    HorizontalAlignment="Stretch"
                    DisplayMemberPath="DisplayName"
                    Header="Mappa"
                    SelectionChanged="MapComboBox_SelectionChanged" />
                <NumberBox
                    x:Name="PlayerXNumberBox"
                    Grid.Column="1"
                    Header="Spawn X"
                    Minimum="0"
                    SpinButtonPlacementMode="Compact" />
                <NumberBox
                    x:Name="PlayerYNumberBox"
                    Grid.Column="2"
                    Header="Spawn Y"
                    Minimum="0"
                    SpinButtonPlacementMode="Compact" />
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox
                    x:Name="DirectionComboBox"
                    HorizontalAlignment="Stretch"
                    DisplayMemberPath="DisplayName"
                    Header="Direzione iniziale" />
                <NumberBox
                    x:Name="CommonEventNumberBox"
                    Grid.Column="1"
                    Header="Evento comune d'ingresso (opzionale)"
                    Minimum="0"
                    SpinButtonPlacementMode="Compact" />
            </Grid>

            <TextBlock
                x:Name="MapHintTextBlock"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                FontSize="12"
                TextWrapping="Wrap" />

            <Border
                Padding="14"
                Background="#142333"
                BorderBrush="#31506C"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="5">
                    <TextBlock FontWeight="SemiBold" Text="Loadout fisso del playtest" />
                    <TextBlock Text="Yato · livello 50 · arma #132" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Armature: #1, #2, #3, #4, #26, #24, #24, #28 · Skill apprese: #7, #15, #61"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
